@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject DiscoveryTriggerState DiscoveryTrigger
@implements IDisposable

<header class="top-bar">
    <h1>@PageTitle</h1>
    <div class="top-bar-spacer"></div>
    <GlobalSearch />
    <button class="ui-button secondary" type="button" @onclick="ToggleTheme">Theme: @ThemeName</button>
    @if (IsOverview)
    {
        <Button Disabled="@DiscoveryTrigger.IsRunning" OnClick="RequestDiscovery">@(DiscoveryTrigger.IsRunning ? "Discovering…" : "Run discovery")</Button>
    }
</header>

@code {
    private string ThemeName { get; set; } = "Light";

    private bool IsOverview => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') is "";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        DiscoveryTrigger.Changed += OnDiscoveryChanged;
    }

    // The path only: a query (search deep links such as /topology?node=…) does not change the title.
    private string PageTitle => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') switch
    {
        "" => "Overview",
        "topology" => "Topology",
        "drift" => "Drift",
        "servers" => "Servers",
        "alerts" => "Alerts",
        "updates" => "Updates",
        "agent-chat" => "Agent chat",
        "action-log" => "Action log",
        "settings" => "Settings",
        "settings/llm" => "Settings",
        "dev/components" => "Components",
        _ => "DevOps Agent"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JavaScript.InvokeAsync<string>("dvaTheme.current");
            ThemeName = current == "dark" ? "Dark" : "Light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        var current = await JavaScript.InvokeAsync<string>("dvaTheme.toggle");
        ThemeName = current == "dark" ? "Dark" : "Light";
    }

    private void RequestDiscovery() => DiscoveryTrigger.RequestRun();

    private void OnDiscoveryChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        DiscoveryTrigger.Changed -= OnDiscoveryChanged;
    }
}
