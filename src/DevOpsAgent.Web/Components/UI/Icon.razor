<svg class="icon @SizeClass" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "search":
            <circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m12.5 12.5 4 4"></path>
            break;
        case "server":
            <rect x="2.5" y="3" width="15" height="5" rx="1.5"></rect><rect x="2.5" y="12" width="15" height="5" rx="1.5"></rect><path d="M5.5 5.5h.01M5.5 14.5h.01"></path>
            break;
        case "updates":
            <path d="M10 2.5v10M6.5 9l3.5 3.5L13.5 9M4 16.5h12"></path>
            break;
        case "alert":
            <path d="m10 2.5 8 14H2z"></path><path d="M10 7v4M10 13.5h.01"></path>
            break;
        case "network":
            <circle cx="4" cy="10" r="2"></circle><circle cx="15.5" cy="4.5" r="2"></circle><circle cx="15.5" cy="15.5" r="2"></circle><path d="m6 9 7.5-3.5M6 11l7.5 3.5"></path>
            break;
        case "chat":
            <path d="M3 4.5h14v10H9l-4 3v-3H3z"></path><path d="M6 8h8M6 11h5"></path>
            break;
        default:
            <circle cx="10" cy="10" r="7"></circle><path d="M10 6v4l2.5 1.5"></path>
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public bool Small { get; set; }
    private string SizeClass => Small ? "small" : string.Empty;
}
