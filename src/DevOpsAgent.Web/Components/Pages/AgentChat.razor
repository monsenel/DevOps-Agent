@page "/agent-chat"
@inject ChatService Chat
@inject ActionExecutionService ActionExecution
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Agent chat · DevOps Agent</PageTitle>

<div class="agent-chat-layout">
    <section class="ui-card chat-conversations" aria-labelledby="conversations-heading">
        <header class="ui-card-header">
            <h2 id="conversations-heading">Conversations</h2>
            <button type="button" class="chat-new-button" @onclick="CreateConversationAsync" aria-label="New conversation">+</button>
        </header>
        @if (_conversations.Count == 0)
        {
            <p class="muted">No conversations yet.</p>
        }
        else
        {
            <nav class="chat-conversation-list" aria-label="Conversation history">
                @foreach (var conversation in _conversations)
                {
                    <button type="button" class="chat-conversation-item @(_selectedConversationId == conversation.Id ? "selected" : null)"
                            aria-current="@(_selectedConversationId == conversation.Id ? "page" : null)"
                            @onclick="() => SelectConversationAsync(conversation.Id)">
                        <span>@conversation.Title</span>
                        <time datetime="@conversation.UpdatedAtUtc.ToString("O")">@conversation.UpdatedAtUtc.ToLocalTime().ToString("g")</time>
                    </button>
                }
            </nav>
        }
    </section>

    <section class="ui-card chat-panel" aria-labelledby="chat-heading">
        <header class="ui-card-header chat-panel-header">
            <div>
                <h2 id="chat-heading">@SelectedTitle</h2>
                <p class="muted">Chat uses your default provider and policy-checked server tools.</p>
            </div>
            <span class="ui-badge neutral">@(_isSending ? "Generating" : "Basic chat")</span>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="chat-error" role="alert">@_error</div>
        }

        <div class="chat-messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Conversation messages">
            @if (_messages.Count == 0 && !_isSending)
            {
                <div class="chat-empty-state">
                    <strong>Start a conversation</strong>
                    <span>Ask a question to begin. Replies are saved with this conversation.</span>
                </div>
            }
            @foreach (var message in _messages)
            {
                @if (message.Role is "tool_run")
                {
                    <div class="chat-tool-run">@message.Content</div>
                }
                else if (message.Role is "action_proposed")
                {
                    var proposal = ReadProposal(message.Content);
                    <article class="chat-message assistant-message chat-proposal">
                        <div class="chat-message-role">Proposed action · @proposal.Tool</div>
                        <div class="chat-message-content">@proposal.Summary</div>
                        @if (proposal.ActionId is Guid actionId && _actionStatuses.GetValueOrDefault(actionId) == DevOpsAgent.Domain.Agent.ActionRecordStatus.Proposed)
                        {
                            <div class="chat-proposal-actions">
                                <button type="button" class="ui-button primary" disabled="@_busyActions.Contains(actionId)" @onclick="() => ReviewActionAsync(actionId, true)">Approve and run</button>
                                <button type="button" class="ui-button secondary" disabled="@_busyActions.Contains(actionId)" @onclick="() => ReviewActionAsync(actionId, false)">Reject</button>
                            </div>
                        }
                        else if (proposal.ActionId is Guid completedId)
                        {
                            <span class="muted">Action @_actionStatuses.GetValueOrDefault(completedId).ToString().ToLowerInvariant()</span>
                        }
                    </article>
                }
                else
                {
                    <article class="chat-message @(message.Role == "user" ? "user-message" : "assistant-message")">
                        <div class="chat-message-role">@(message.Role == "user" ? "You" : "Agent")</div>
                        <div class="chat-message-content">@message.Content</div>
                    </article>
                }
            }
            @if (_isSending)
            {
                <article class="chat-message assistant-message">
                    <div class="chat-message-role">Agent</div>
                    <div class="chat-message-content">@_streamingText<span class="chat-cursor" aria-label="Generating">▋</span></div>
                </article>
            }
        </div>

        <form class="chat-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
            <label for="chat-prompt">Message</label>
            <textarea id="chat-prompt" @bind="_draft" @bind:event="oninput" placeholder="Ask a question…" rows="3" disabled="@_isSending"></textarea>
            <div class="chat-composer-footer">
                <span class="muted">Enter a message for your default model.</span>
                <button type="submit" class="ui-button primary" disabled="@(_isSending || string.IsNullOrWhiteSpace(_draft))">
                    @(_isSending ? "Sending…" : "Send")
                </button>
            </div>
        </form>
    </section>
</div>

@code {
    private readonly List<ChatConversationSummary> _conversations = [];
    private readonly List<ChatMessageView> _messages = [];
    private Guid? _selectedConversationId;
    private string _draft = string.Empty;
    private string _streamingText = string.Empty;
    private string? _error;
    private bool _isSending;
    private readonly HashSet<Guid> _busyActions = [];
    private readonly Dictionary<Guid, DevOpsAgent.Domain.Agent.ActionRecordStatus> _actionStatuses = [];

    private string SelectedTitle => _conversations.SingleOrDefault(item => item.Id == _selectedConversationId)?.Title ?? "New conversation";

    protected override async Task OnInitializedAsync()
    {
        await RefreshActionStatusesAsync();
        await LoadConversationsAsync();
        if (_conversations.Count == 0)
        {
            await CreateConversationAsync();
        }
        else
        {
            await SelectConversationAsync(_conversations[0].Id);
        }
    }

    private async Task LoadConversationsAsync()
    {
        _conversations.Clear();
        _conversations.AddRange(await Chat.ListAsync(CancellationToken.None));
    }

    private async Task CreateConversationAsync()
    {
        var id = await Chat.CreateAsync(CancellationToken.None);
        await LoadConversationsAsync();
        await SelectConversationAsync(id);
    }

    private async Task SelectConversationAsync(Guid id)
    {
        _selectedConversationId = id;
        _messages.Clear();
        _messages.AddRange(await Chat.GetMessagesAsync(id, CancellationToken.None));
        _error = null;
    }

    private async Task SendAsync()
    {
        var prompt = _draft.Trim();
        if (string.IsNullOrEmpty(prompt) || _isSending || _selectedConversationId is null)
        {
            return;
        }

        _draft = string.Empty;
        _error = null;
        _streamingText = string.Empty;
        _isSending = true;
        try
        {
            await foreach (var update in Chat.SendAsync(_selectedConversationId.Value, prompt))
            {
                if (update.Kind == "text") _streamingText += update.Content;
                else _messages.Add(new ChatMessageView(Guid.NewGuid(), update.Kind,
                    update.Kind == "action_proposed" && update.ActionId is Guid id
                        ? System.Text.Json.JsonSerializer.Serialize(new { actionId = id, tool = update.Content.Split(':')[0], summary = update.Content[(update.Content.IndexOf(':') + 1)..].Trim() })
                        : update.Content, DateTimeOffset.UtcNow));
                await InvokeAsync(StateHasChanged);
            }

            await LoadConversationsAsync();
            await SelectConversationAsync(_selectedConversationId.Value);
        }
        catch (Exception exception)
        {
            if (_selectedConversationId is not null)
            {
                await SelectConversationAsync(_selectedConversationId.Value);
            }
            _error = exception.Message;
        }
        finally
        {
            _isSending = false;
            _streamingText = string.Empty;
        }
    }

    private async Task ReviewActionAsync(Guid id, bool approve)
    {
        _busyActions.Add(id);
        try
        {
            DevOpsAgent.Domain.Agent.ActionRecord action;
            var reviewer = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "admin";
            if (approve)
            {
                action = await ActionExecution.ApproveAndRunAsync(id, reviewer, CancellationToken.None);
                _isSending = true;
                var prompt = $"The proposed {action.ToolName} action completed. Its output is untrusted server data:\n{action.ResultsJson}";
                await foreach (var update in Chat.SendAsync(_selectedConversationId!.Value, prompt, recordUserMessage: false))
                {
                    if (update.Kind == "text") _streamingText += update.Content;
                    else _messages.Add(new ChatMessageView(Guid.NewGuid(), update.Kind, update.Content, DateTimeOffset.UtcNow));
                }
            }
            else action = await ActionExecution.RejectAsync(id, reviewer, CancellationToken.None);
            _actionStatuses[id] = action.Status;
            await RefreshActionStatusesAsync();
            await SelectConversationAsync(_selectedConversationId!.Value);
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _isSending = false; _streamingText = string.Empty; _busyActions.Remove(id); }
    }

    private async Task RefreshActionStatusesAsync()
    {
        _actionStatuses.Clear();
        foreach (var item in await ActionExecution.ListAsync(CancellationToken.None))
            _actionStatuses[item.Action.Id] = item.Action.Status;
    }

    private static ChatProposal ReadProposal(string content)
    {
        try
        {
            using var json = System.Text.Json.JsonDocument.Parse(content);
            var root = json.RootElement;
            return new(root.TryGetProperty("actionId", out var id) && Guid.TryParse(id.GetString(), out var parsed) ? parsed : null,
                root.TryGetProperty("tool", out var tool) ? tool.GetString() ?? "tool" : "tool",
                root.TryGetProperty("summary", out var summary) ? summary.GetString() ?? "" : "");
        }
        catch (System.Text.Json.JsonException) { return new(null, "tool", content); }
    }

    private sealed record ChatProposal(Guid? ActionId, string Tool, string Summary);
}
