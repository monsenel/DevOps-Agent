@page "/drift"
@using System.Text.Json
@inject DriftService DriftService
@inject IGraphRepository GraphRepository
<PageTitle>Drift · DevOps Agent</PageTitle>

<div class="page-stack drift-page">
    <section class="ui-card drift-controls" aria-labelledby="drift-title">
        <div class="servers-heading">
            <div>
                <p class="eyebrow">Snapshots</p>
                <h2 id="drift-title">Infrastructure drift</h2>
                <p class="muted">Compare two discovery runs to inspect added, modified, and removed hosts, listeners, and connections.</p>
            </div>
            @if (_snapshots.Count >= 2)
            {
                <button class="ui-button primary" type="button" disabled="@_loading" @onclick="CompareAsync">
                    @(_loading ? "Comparing…" : "Compare snapshots")
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert-message error" role="alert">@_error</div>
        }

        @if (_snapshots.Count < 2)
        {
            <div class="empty-state drift-empty">
                <h3>Two completed snapshots are needed</h3>
                <p class="muted">Run discovery again after your first snapshot to compare changes across servers and services.</p>
                <a class="ui-button primary" href="/topology">Open topology</a>
            </div>
        }
        else
        {
            <div class="drift-snapshot-pickers">
                <div class="select-field">
                    <label for="drift-from">From snapshot (baseline)</label>
                    <select id="drift-from" @bind="_fromSnapshotValue">
                        @foreach (var snapshot in _snapshots)
                        {
                            <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                        }
                    </select>
                </div>
                <div class="select-field">
                    <label for="drift-to">To snapshot (current)</label>
                    <select id="drift-to" @bind="_toSnapshotValue">
                        @foreach (var snapshot in _snapshots)
                        {
                            <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option>
                        }
                    </select>
                </div>
            </div>
        }
    </section>

    @if (_report is not null)
    {
        var addedCount = _report.Changes.Count(item => item.ChangeType == DriftChangeType.Added);
        var changedCount = _report.Changes.Count(item => item.ChangeType == DriftChangeType.Changed);
        var removedCount = _report.Changes.Count(item => item.ChangeType == DriftChangeType.Removed);
        var filteredChanges = FilteredChanges;

        <div class="bento-row">
            <StatTile Label="Total changes" Value="@_report.Changes.Count.ToString()" Suffix="@($"{_report.NewListeners.Count} new listener(s)")" IconName="activity" />
            <StatTile Label="Added" Value="@addedCount.ToString()" Suffix="nodes / edges / listeners" IconName="server" />
            <StatTile Label="Changed" Value="@changedCount.ToString()" Suffix="attributes or ports" IconName="activity" />
            <StatTile Label="Removed" Value="@removedCount.ToString()" Suffix="no longer present" IconName="alert" Emphasized="@(removedCount > 0)" />
        </div>

        <div class="drift-content-row">
            <section class="ui-card drift-list-card" aria-labelledby="drift-list-title">
                <header class="ui-card-header">
                    <div>
                        <h2 id="drift-list-title">Changes</h2>
                        <p class="muted">@filteredChanges.Count of @_report.Changes.Count matching items</p>
                    </div>
                    <div class="card-actions">
                        <div class="segmented-control" role="group" aria-label="Change type filter">
                            <button type="button" class="@(_typeFilter is null ? "active" : null)" @onclick="() => _typeFilter = null">All</button>
                            <button type="button" class="@(_typeFilter == DriftChangeType.Added ? "active" : null)" @onclick="() => _typeFilter = DriftChangeType.Added">Added</button>
                            <button type="button" class="@(_typeFilter == DriftChangeType.Changed ? "active" : null)" @onclick="() => _typeFilter = DriftChangeType.Changed">Changed</button>
                            <button type="button" class="@(_typeFilter == DriftChangeType.Removed ? "active" : null)" @onclick="() => _typeFilter = DriftChangeType.Removed">Removed</button>
                        </div>
                    </div>
                </header>

                @if (_report.Changes.Count > 0)
                {
                    <div class="field drift-filter-field">
                        <label for="drift-search" class="visually-hidden">Filter changes</label>
                        <input id="drift-search" type="search" @bind="_searchQuery" @bind:event="oninput" placeholder="Search host, service, port, or description…" />
                    </div>
                }

                @if (_report.Changes.Count == 0)
                {
                    <p class="muted">These snapshots match. No node, listener, or connection changes were found.</p>
                }
                else if (filteredChanges.Count == 0)
                {
                    <p class="muted">No changes match the active filter.</p>
                }
                else
                {
                    <ul class="drift-change-list">
                        @foreach (var change in filteredChanges)
                        {
                            <li class="drift-change-row @ChangeClass(change.ChangeType)" @key="@($"{change.EntityType}|{change.ChangeType}|{change.Key}")">
                                <span class="drift-change-kind">@change.ChangeType</span>
                                <span class="drift-change-description">@DisplayDescription(change)</span>
                                <span class="ui-badge neutral">@change.EntityType</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ui-card drift-graph-card" aria-labelledby="drift-graph-title">
                <header class="ui-card-header">
                    <div>
                        <h2 id="drift-graph-title">Graph highlights</h2>
                        <p class="muted">Visual summary of affected infrastructure elements and connections.</p>
                    </div>
                    <a class="ui-button secondary" href="/topology">Open live map</a>
                </header>
                <div class="drift-graph-legend" aria-label="Change legend">
                    <span class="ui-badge soft">Added</span>
                    <span class="ui-badge warn">Changed</span>
                    <span class="ui-badge danger">Removed</span>
                    <span class="ui-badge neutral">Unchanged context</span>
                </div>
                @if (_highlightCards.Count == 0 && _highlightEdges.Count == 0)
                {
                    <p class="muted">No graph elements are available for these snapshots.</p>
                }
                else
                {
                    <div class="drift-highlight-grid">
                        @foreach (var card in _highlightCards)
                        {
                            <article class="drift-highlight-node @card.Class" @key="card.Key">
                                <div class="drift-highlight-top">
                                    <strong>@card.Label</strong>
                                    <span class="ui-badge @StatusBadgeClass(card.Status)">@card.Status</span>
                                </div>
                                <span class="mono muted drift-highlight-meta">@card.Kind</span>
                            </article>
                        }
                    </div>

                    @if (_highlightEdges.Count > 0)
                    {
                        <div class="drift-edge-section">
                            <p class="eyebrow">Connection changes</p>
                            <ul class="drift-edge-list">
                                @foreach (var edge in _highlightEdges)
                                {
                                    <li class="drift-edge-item @edge.Class" @key="edge.Identity">
                                        <span class="drift-edge-route">@edge.SourceLabel → @edge.TargetLabel</span>
                                        <span class="mono muted">@edge.Meta</span>
                                        <span class="ui-badge @StatusBadgeClass(edge.Status)">@edge.Status</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    private IReadOnlyList<SnapshotSummary> _snapshots = [];
    private DriftReport? _report;
    private GraphSnapshotDto? _fromGraph;
    private GraphSnapshotDto? _toGraph;
    private IReadOnlyList<HighlightNode> _highlightCards = [];
    private IReadOnlyList<HighlightEdge> _highlightEdges = [];
    private string? _fromSnapshotValue;
    private string? _toSnapshotValue;
    private string _searchQuery = string.Empty;
    private DriftChangeType? _typeFilter;
    private string? _error;
    private bool _loading;

    private IReadOnlyList<DriftChange> FilteredChanges => (_report?.Changes ?? [])
        .Where(change => _typeFilter is null || change.ChangeType == _typeFilter)
        .Where(change => string.IsNullOrWhiteSpace(_searchQuery)
            || change.Description.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
            || change.EntityType.ToString().Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _snapshots = await DriftService.ListSnapshotsAsync(CancellationToken.None);
        if (_snapshots.Count < 2) return;
        _fromSnapshotValue = _snapshots[1].Id.ToString();
        _toSnapshotValue = _snapshots[0].Id.ToString();
        await CompareAsync();
    }

    private async Task CompareAsync()
    {
        if (!Guid.TryParse(_fromSnapshotValue, out var fromId) || !Guid.TryParse(_toSnapshotValue, out var toId)) return;
        _loading = true;
        _error = null;
        try
        {
            _report = await DriftService.CompareAsync(fromId, toId, CancellationToken.None);
            _fromGraph = await GraphRepository.GetAsync(fromId, GraphView.All, CancellationToken.None);
            _toGraph = await GraphRepository.GetAsync(toId, GraphView.All, CancellationToken.None);
            BuildHighlights();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _report = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildHighlights()
    {
        if (_report is null || _fromGraph is null || _toGraph is null)
        {
            _highlightCards = [];
            _highlightEdges = [];
            return;
        }

        var changes = _report.Changes;
        var changeByNode = changes.Where(change => change.EntityType == DriftEntityType.Node && change.NodeKey is not null)
            .GroupBy(change => change.NodeKey!, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.OrderBy(change => change.ChangeType == DriftChangeType.Changed ? 0 : 1).First(), StringComparer.Ordinal);
        var fromNodes = NodesByKey(_fromGraph);
        var toNodes = NodesByKey(_toGraph);
        var affectedKeys = changes.SelectMany(change => new[] { change.NodeKey, change.SourceNodeKey, change.TargetNodeKey })
            .Where(key => key is not null).Select(key => key!).Distinct(StringComparer.Ordinal).ToArray();
        var orderedKeys = affectedKeys.Concat(toNodes.Keys).Concat(fromNodes.Keys)
            .Distinct(StringComparer.Ordinal).Take(24).ToArray();

        var cards = new List<HighlightNode>();
        foreach (var key in orderedKeys)
        {
            if (!toNodes.TryGetValue(key, out var data) && !fromNodes.TryGetValue(key, out data)) continue;
            var status = changeByNode.TryGetValue(key, out var change) ? change.ChangeType.ToString() : "Unchanged";
            cards.Add(new HighlightNode(key, ReadString(data, "label") ?? key, ReadString(data, "kind") ?? "Node", status, ChangeClass(change?.ChangeType)));
        }

        var edgeChanges = changes.Where(change => change.EntityType == DriftEntityType.Edge)
            .ToDictionary(change => change.Key, change => change, StringComparer.Ordinal);
        var edgeByIdentity = new Dictionary<string, EdgeView>(StringComparer.Ordinal);
        AddEdges(_toGraph, toNodes, edgeByIdentity);
        AddEdges(_fromGraph, fromNodes, edgeByIdentity);

        string NodeLabel(string key) =>
            (toNodes.TryGetValue(key, out var d) || fromNodes.TryGetValue(key, out d))
                ? (ReadString(d, "label") ?? key)
                : key;

        _highlightEdges = edgeByIdentity.Values
            .Select(edge =>
            {
                var status = edgeChanges.TryGetValue(edge.Identity, out var change) ? change.ChangeType : (DriftChangeType?)null;
                return new HighlightEdge(edge.Identity, NodeLabel(edge.SourceKey), NodeLabel(edge.TargetKey), edge.Meta,
                    status?.ToString() ?? "Unchanged", ChangeClass(status));
            })
            .OrderBy(item => item.Status == "Unchanged" ? 1 : 0)
            .Take(20)
            .ToArray();
        _highlightCards = cards;
    }

    private static Dictionary<string, JsonElement> NodesByKey(GraphSnapshotDto graph) => graph.Nodes
        .Select(element => element.Data).ToDictionary(node => ReadString(node, "key") ?? string.Empty,
            node => node, StringComparer.Ordinal);

    private static void AddEdges(GraphSnapshotDto graph, IReadOnlyDictionary<string, JsonElement> nodes,
        IDictionary<string, EdgeView> output)
    {
        var keyById = nodes.Values.ToDictionary(node => ReadString(node, "id") ?? string.Empty,
            node => ReadString(node, "key") ?? string.Empty, StringComparer.Ordinal);
        foreach (var element in graph.Edges)
        {
            var edge = element.Data;
            if (!keyById.TryGetValue(ReadString(edge, "source") ?? string.Empty, out var source)
                || !keyById.TryGetValue(ReadString(edge, "target") ?? string.Empty, out var target)) continue;
            var port = TryGetValue(edge, "port");
            var kind = ReadString(edge, "kind") ?? string.Empty;
            var protocol = ReadString(edge, "protocol") ?? string.Empty;
            var identity = $"{source}\u001f{target}\u001f{kind}\u001f{port}\u001f{protocol}";
            var meta = string.IsNullOrWhiteSpace(port) ? kind : $":{port}/{protocol} · {kind}";
            output.TryAdd(identity, new EdgeView(identity, source, target, meta));
        }
    }

    private static string? ReadString(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    private static string? TryGetValue(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : null;

    private static string ChangeClass(DriftChangeType? type) => type switch
    {
        DriftChangeType.Added => "added",
        DriftChangeType.Removed => "removed",
        DriftChangeType.Changed => "changed",
        _ => "neutral"
    };

    private static string ChangeClass(DriftChangeType type) => ChangeClass((DriftChangeType?)type);

    private static string StatusBadgeClass(string status) => status switch
    {
        "Added" => "soft",
        "Changed" => "warn",
        "Removed" => "danger",
        _ => "neutral"
    };

    private static string SnapshotLabel(SnapshotSummary snapshot) =>
        $"{snapshot.StartedAtUtc.ToLocalTime():g} · {snapshot.Status} · {snapshot.SucceededServerCount} ok / {snapshot.FailedServerCount} failed";

    private static string DisplayDescription(DriftChange change)
    {
        var prefix = $"{change.ChangeType} ";
        return change.Description.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? change.Description[prefix.Length..]
            : change.Description;
    }

    private sealed record EdgeView(string Identity, string SourceKey, string TargetKey, string Meta);
    private sealed record HighlightNode(string Key, string Label, string Kind, string Status, string Class);
    private sealed record HighlightEdge(string Identity, string SourceLabel, string TargetLabel, string Meta, string Status, string Class);
}
