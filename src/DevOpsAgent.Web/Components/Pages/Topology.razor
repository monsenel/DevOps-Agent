@page "/topology"
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject IGraphRepository GraphRepository
@inject ISnapshotRepository SnapshotRepository
@inject IDiscoveryCoordinator Discovery
@inject ServerService ServersService
@inject VmInspectorService VmInspector
@inject NavigationManager Navigation
@inject AlertService AlertManager
@using System.Globalization
@using System.Text.Json
@using DevOpsAgent.Domain.Discovery
@using DevOpsAgent.Application.Servers

<PageTitle>Topology · DevOps Agent</PageTitle>

<div class="topology-stage @(_fullscreen ? "fullscreen" : null)" tabindex="-1" @onkeydown="HandleStageKeyDown">
    <section class="ui-card topology-graph-card" aria-labelledby="topology-graph-title">
        <div @ref="_graphHost" class="topology-graph" role="img"
             aria-label="Interactive infrastructure graph. Click a server or open the Inspector drawer to browse nodes and edges."></div>

        <div class="topology-overlay-shell">
            @* Top floating collapsible Discovery & Filter toolbar (collapsed by default so the map fills the page). *@
            <div class="topology-float-top" aria-label="Topology controls">
                <div class="topology-float-bar">
                    <div class="topology-toolbar-row">
                        <div class="segmented-control" role="group" aria-label="Graph view">
                            <button type="button" class="@(CurrentView == TopologyView.Servers ? "active" : null)" aria-pressed="@(CurrentView == TopologyView.Servers)" @onclick="() => ChangeViewAsync(TopologyView.Servers)">Servers</button>
                            <button type="button" class="@(CurrentView == TopologyView.Service ? "active" : null)" aria-pressed="@(CurrentView == TopologyView.Service)" @onclick="() => ChangeViewAsync(TopologyView.Service)">Service</button>
                            <button type="button" class="@(CurrentView == TopologyView.Network ? "active" : null)" aria-pressed="@(CurrentView == TopologyView.Network)" @onclick="() => ChangeViewAsync(TopologyView.Network)">Network</button>
                        </div>

                        <form class="topology-search" role="search" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault>
                            <label for="topology-search-input" class="visually-hidden">Search topology</label>
                            <input id="topology-search-input" type="search" placeholder="Search name, IP, port…" value="@_search" @oninput="SearchChanged" />
                            <button class="ui-button secondary" type="submit" disabled="@(_graph is null)">Search</button>
                        </form>

                        <div class="topology-float-actions">
                            <button class="ui-button secondary" type="button" aria-expanded="@_discoveryExpanded" @onclick="() => _discoveryExpanded = !_discoveryExpanded">
                                @(_discoveryExpanded ? "Hide filters" : ActiveFilterCount > 0 ? $"Filters ({ActiveFilterCount})" : "Discovery & filters")
                            </button>
                            <button class="ui-button primary" type="button" disabled="@_discovering" @onclick="RunDiscoveryAsync">
                                @(_discovering ? "Discovering…" : "Run discovery")
                            </button>
                        </div>
                    </div>

                    @if (_discoveryExpanded)
                    {
                        <div class="topology-expanded-panel">
                            <div class="topology-expanded-grid">
                                <form class="topology-trace" @onsubmit="TraceAsync" @onsubmit:preventDefault>
                                    <label for="topology-trace-input">Trace domain</label>
                                    <input id="topology-trace-input" type="text" placeholder="api.example.com or URL" @bind="_traceQuery" @bind:event="oninput" />
                                    <button class="ui-button secondary" type="submit" disabled="@(_graph is null)">Trace</button>
                                    @if (_tracedNodeIds.Count > 0)
                                    {
                                        <button class="ui-button secondary" type="button" @onclick="ClearTraceAsync">Clear trace</button>
                                    }
                                </form>

                                <label class="topology-filter">
                                    <span class="visually-hidden">Filter by tag</span>
                                    <select value="@_selectedTag" @onchange="TagChanged">
                                        <option value="">All tags</option>
                                        @foreach (var tag in _tags)
                                        {
                                            <option value="@tag">Tag: @tag</option>
                                        }
                                    </select>
                                </label>
                                <label class="topology-filter">
                                    <span class="visually-hidden">Filter by Compose project</span>
                                    <select value="@_selectedProject" @onchange="ProjectChanged">
                                        <option value="">All projects</option>
                                        @foreach (var project in _projects)
                                        {
                                            <option value="@project">Project: @project</option>
                                        }
                                    </select>
                                </label>
                                <label class="topology-filter">
                                    <span class="visually-hidden">Filter by subnet</span>
                                    <select value="@_selectedSubnet" @onchange="SubnetChanged">
                                        <option value="">All subnets</option>
                                        @foreach (var subnet in _subnets)
                                        {
                                            <option value="@subnet">Subnet: @subnet</option>
                                        }
                                    </select>
                                </label>
                            </div>

                            <div class="topology-legend" aria-label="Graph legend">
                                <span><i class="legend-line observed"></i>Declared + observed</span>
                                <span><i class="legend-line only-observed"></i>Observed only</span>
                                <span><i class="legend-line traced"></i>Traced path</span>
                                @if ((_latestRun ?? _snapshot) is { } lastRun)
                                {
                                    <span class="muted topology-last-run">Last discovery @lastRun.StartedAtUtc.ToLocalTime().ToString("g") · @lastRun.Status</span>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_progressMessage))
                    {
                        <div class="topology-progress" role="status" aria-live="polite">
                            <span class="progress-track"><span style="width:@ProgressPercent%"></span></span>
                            <span>@_progressMessage</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_pageError))
                    {
                        <div class="alert-message error" role="alert">@_pageError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_traceMessage))
                    {
                        <p class="topology-trace-message" role="status">@_traceMessage</p>
                    }
                </div>
            </div>

            @* Middle flexible lane: right-aligned floating Inspector launcher OR open drawer (never overlaps top bar or bottom controls). *@
            <div class="topology-overlay-middle">
                @if (!_detailsOpen)
                {
                    <button type="button" class="ui-button secondary topology-drawer-launcher" @onclick="OpenInspectorIndex">
                        @(_selected is null ? "Inspector & index" : $"Details · {SelectedTitle}")
                    </button>
                }
                else
                {
                    <aside class="ui-card topology-float-drawer" aria-labelledby="topology-details-title" aria-live="polite">
                        <header class="topology-drawer-header">
                            <div class="topology-drawer-title">
                                <p class="eyebrow">@(_vmSnapshot is not null ? $"VM · {_vmSnapshot.Group}" : "Selection")</p>
                                <h2 id="topology-details-title">@(_selected is null ? "Map index" : SelectedTitle)</h2>
                                @if (_vmSnapshot is { } headerVm)
                                {
                                    <p class="muted mono topology-drawer-subtitle">
                                        @headerVm.Host
                                        @if (!string.IsNullOrWhiteSpace(headerVm.OsInfo))
                                        {
                                            <span> · @headerVm.OsInfo</span>
                                        }
                                        @if (headerVm.Resources.SystemUptimeSeconds is { } uptimeSec)
                                        {
                                            <span> · up @VmInspectorService.FormatDuration(TimeSpan.FromSeconds(uptimeSec))</span>
                                        }
                                    </p>
                                }
                            </div>
                            <div class="topology-drawer-head-actions">
                                @if (_vmSnapshot is { } refreshVm)
                                {
                                    <button type="button" class="ui-button secondary topology-mini-btn" disabled="@_vmRefreshing"
                                            @onclick="() => RefreshLiveVmAsync(refreshVm.ServerId)" title="Fetch fresh CPU, RAM, ports, and processes over SSH">
                                        @(_vmRefreshing ? "Refreshing…" : "Live refresh")
                                    </button>
                                }
                                <button type="button" class="ui-button secondary icon-button" @onclick="CloseDrawer" aria-label="Close details panel" title="Close">×</button>
                            </div>
                        </header>

                        <div class="segmented-control topology-drawer-tabs" role="tablist" aria-label="Inspector sections">
                            @if (_vmSnapshot is not null || _vmLoading)
                            {
                                <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Overview)" class="@(_inspectorTab == InspectorTab.Overview ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Overview">Overview</button>
                                <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Services)" class="@(_inspectorTab == InspectorTab.Services ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Services">Services</button>
                                <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Ports)" class="@(_inspectorTab == InspectorTab.Ports ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Ports">Ports</button>
                                <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Processes)" class="@(_inspectorTab == InspectorTab.Processes ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Processes">Procs</button>
                                <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Network)" class="@(_inspectorTab == InspectorTab.Network ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Network">SSH</button>
                            }
                            else if (_selected is not null)
                            {
                                <button type="button" role="tab" aria-selected="@(_inspectorTab != InspectorTab.Index)" class="@(_inspectorTab != InspectorTab.Index ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Network">Details</button>
                            }
                            <button type="button" role="tab" aria-selected="@(_inspectorTab == InspectorTab.Index)" class="@(_inspectorTab == InspectorTab.Index ? "active" : null)" @onclick="() => _inspectorTab = InspectorTab.Index">Index</button>
                        </div>

                        <div class="topology-drawer-body">
                    @if (!string.IsNullOrWhiteSpace(_vmError))
                    {
                        <div class="alert-message error" role="alert">@_vmError</div>
                    }
                    @if (_vmSnapshot?.Warning is { Length: > 0 } vmWarn)
                    {
                        <p class="topology-stale-note"><span class="ui-badge warn">Partial</span><span class="muted">@vmWarn</span></p>
                    }

                    @if (_inspectorTab == InspectorTab.Index)
                    {
                        <div class="topology-index-section">
                            <h3>Nodes (@_visibleNodes.Count)</h3>
                            @if (_visibleNodes.Count == 0)
                            {
                                <p class="muted">No nodes match the current filter.</p>
                            }
                            else
                            {
                                <nav class="topology-node-list" aria-label="Graph nodes">
                                    @foreach (var node in _visibleNodes)
                                    {
                                        var id = ReadString(node, "id");
                                        <button type="button" @key="id" aria-pressed="@(_selectedId == id)" @onclick="() => SelectNodeAndFocusAsync(node)">
                                            <span class="topology-node-kind">@ReadString(node, "kind")</span>
                                            <span>@GraphNodeLabel.Describe(node)</span>
                                        </button>
                                    }
                                </nav>
                            }
                        </div>
                        @if (VisibleEdges.Count > 0)
                        {
                            <div class="topology-index-section">
                                <h3>Connections (@VisibleEdges.Count)</h3>
                                <nav class="topology-node-list" aria-label="Graph edges">
                                    @foreach (var edge in VisibleEdges)
                                    {
                                        var id = ReadString(edge, "id");
                                        <button type="button" @key="id" aria-pressed="@(_selectedId == id)" @onclick="() => SelectEdgeAsync(edge)">
                                            <span class="topology-node-kind">@ReadString(edge, "kind")</span>
                                            <span>@FindNodeName(ReadString(edge, "source") ?? "") → @FindNodeName(ReadString(edge, "target") ?? "") @PortLabel(edge)</span>
                                        </button>
                                    }
                                </nav>
                            </div>
                        }
                    }
                    else if (_vmLoading && _vmSnapshot is null)
                    {
                        <p class="muted">Loading VM telemetry and services…</p>
                    }
                    else if (_vmSnapshot is { } vm && _inspectorTab == InspectorTab.Overview)
                    {
                        @if (_selected is JsonElement staleSel && !IsEdge(staleSel) && staleSel.TryGetProperty("attributes", out var staleAttr)
                            && StaleCarryForward.Badge(staleAttr) is string staleBadge)
                        {
                            <p class="topology-stale-note"><span class="ui-badge warn">@staleBadge</span>
                                <span class="muted">The server was unreachable at the last discovery; showing its last known state.</span></p>
                        }

                        <div class="vm-status-strip">
                            @if (vm.IsLiveRefresh && vm.SnapshotAtUtc is { } liveAt)
                            {
                                <span class="ui-badge soft">Live · @liveAt.ToLocalTime().ToString("T")</span>
                            }
                            else if (vm.SnapshotAtUtc is { } snapAt)
                            {
                                <span class="ui-badge neutral">Snapshot · @snapAt.ToLocalTime().ToString("g")</span>
                            }
                            @if (vm.OpenAlertCount > 0)
                            {
                                <span class="ui-badge danger">@vm.OpenAlertCount open alert@(vm.OpenAlertCount == 1 ? "" : "s")</span>
                            }
                            <span class="ui-badge @(vm.DockerDaemonRunning ? "soft" : vm.DockerInstalled ? "warn" : "neutral")">
                                @(vm.DockerDaemonRunning ? "Docker running" : vm.DockerInstalled ? "Docker stopped" : "No Docker")
                            </span>
                        </div>

                        <section class="vm-resource-grid" aria-label="VM resources">
                            <div class="vm-resource-card">
                                <div class="vm-resource-top">
                                    <span class="muted">CPU</span>
                                    <strong class="mono">@FormatPercent(vm.Resources.CpuPercent)</strong>
                                </div>
                                <span class="vm-progress-track"><span class="vm-progress-fill @ProgressClass(vm.Resources.CpuPercent)" style="width:@BarWidth(vm.Resources.CpuPercent)%"></span></span>
                                <span class="muted vm-resource-sub">@(vm.Resources.CpuCores is { } c ? $"{c} cores" : "cores unknown") · load @FormatLoad(vm.Resources)</span>
                            </div>

                            <div class="vm-resource-card">
                                <div class="vm-resource-top">
                                    <span class="muted">Memory</span>
                                    <strong class="mono">@FormatPercent(vm.Resources.MemoryPercent)</strong>
                                </div>
                                <span class="vm-progress-track"><span class="vm-progress-fill @ProgressClass(vm.Resources.MemoryPercent)" style="width:@BarWidth(vm.Resources.MemoryPercent)%"></span></span>
                                <span class="muted vm-resource-sub">@FormatBytesPair(vm.Resources.MemoryUsedBytes, vm.Resources.MemoryTotalBytes)</span>
                            </div>

                            <div class="vm-resource-card">
                                <div class="vm-resource-top">
                                    <span class="muted">Disk /</span>
                                    <strong class="mono">@FormatPercent(vm.Resources.DiskPercent)</strong>
                                </div>
                                <span class="vm-progress-track"><span class="vm-progress-fill @ProgressClass(vm.Resources.DiskPercent)" style="width:@BarWidth(vm.Resources.DiskPercent)%"></span></span>
                                <span class="muted vm-resource-sub">@FormatBytesPair(vm.Resources.DiskUsedBytes, vm.Resources.DiskTotalBytes)</span>
                            </div>

                            <div class="vm-resource-card">
                                <div class="vm-resource-top">
                                    <span class="muted">Network / Uptime</span>
                                    <strong class="mono">@(vm.Resources.SystemUptimeSeconds is { } up ? VmInspectorService.FormatDuration(TimeSpan.FromSeconds(up)) : "—")</strong>
                                </div>
                                <span class="muted vm-resource-sub mono">↓ @FormatRate(vm.Resources.NetworkRxBytesPerSec) · ↑ @FormatRate(vm.Resources.NetworkTxBytesPerSec)</span>
                            </div>
                        </section>

                        <div class="vm-quick-counts">
                            <button type="button" class="vm-count-chip" @onclick="() => _inspectorTab = InspectorTab.Services">
                                <strong>@vm.Containers.Count</strong>
                                <span class="muted">Containers</span>
                            </button>
                            <button type="button" class="vm-count-chip" @onclick="() => _inspectorTab = InspectorTab.Services">
                                <strong>@vm.SystemdServices.Count(s => !s.IsOsService)</strong>
                                <span class="muted">Services</span>
                            </button>
                            <button type="button" class="vm-count-chip" @onclick="() => _inspectorTab = InspectorTab.Ports">
                                <strong>@vm.Ports.Count(p => p.Exposure == PortExposure.External) / @vm.Ports.Count</strong>
                                <span class="muted">Ext / Ports</span>
                            </button>
                            <button type="button" class="vm-count-chip" @onclick="() => _inspectorTab = InspectorTab.Processes">
                                <strong>@vm.Processes.Count</strong>
                                <span class="muted">Top procs</span>
                            </button>
                        </div>

                        <div class="vm-quick-links">
                            <a class="ui-button secondary" href="/servers/@vm.ServerId">Server detail</a>
                            <a class="ui-button primary" href="@BuildAskAgentUrl(vm)">Ask agent about VM</a>
                        </div>

                        @if (_selected is JsonElement sel)
                        {
                            @RenderNodeAttributes(sel)
                        }
                    }
                    else if (_vmSnapshot is { } vmSvc && _inspectorTab == InspectorTab.Services)
                    {
                        <h3>Docker runtime &amp; containers (@vmSvc.Containers.Count)</h3>
                        <p class="vm-status-line">
                            <span class="ui-badge @(vmSvc.DockerDaemonRunning ? "soft" : vmSvc.DockerInstalled ? "warn" : "neutral")">
                                @(vmSvc.DockerDaemonRunning ? "Docker active" : vmSvc.DockerInstalled ? "Docker installed (daemon stopped or permission denied)" : "Docker not installed")
                            </span>
                        </p>
                        @if (vmSvc.Containers.Count == 0)
                        {
                            <p class="muted">No containers found on this VM.</p>
                        }
                        else
                        {
                            <ul class="topology-detail-items">
                                @foreach (var container in vmSvc.Containers)
                                {
                                    <li class="vm-service-row" @key="container.Name">
                                        <div class="vm-service-head">
                                            <strong>@container.Name</strong>
                                            <div class="vm-service-badges">
                                                <span class="ui-badge @ContainerBadgeClass(container.State)">@container.State</span>
                                                @if (!string.IsNullOrWhiteSpace(container.HealthStatus))
                                                {
                                                    <span class="ui-badge @(container.HealthStatus == "healthy" ? "soft" : "warn")">@container.HealthStatus</span>
                                                }
                                            </div>
                                        </div>
                                        <span class="mono muted vm-service-meta">@container.Image</span>
                                        <div class="vm-service-foot">
                                            <span class="muted">@container.UptimeText</span>
                                            @if (!string.IsNullOrWhiteSpace(container.ComposeProject))
                                            {
                                                <span class="ui-badge neutral">compose: @container.ComposeProject</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(container.PortsText))
                                        {
                                            <span class="mono muted vm-service-meta">@container.PortsText</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                        <h3>Proxies &amp; application stacks (@vmSvc.AppStacks.Count)</h3>
                        @if (vmSvc.AppStacks.Count == 0)
                        {
                            <p class="muted">No nginx, HAProxy, Traefik, Caddy, DB, or Nexus definitions detected.</p>
                        }
                        else
                        {
                            <ul class="topology-detail-items">
                                @foreach (var stack in vmSvc.AppStacks)
                                {
                                    <li class="vm-service-row">
                                        <div class="vm-service-head">
                                            <strong>@stack.Name</strong>
                                            <span class="ui-badge soft">@stack.Kind</span>
                                        </div>
                                        <span class="mono muted vm-service-meta">@stack.Detail</span>
                                    </li>
                                }
                            </ul>
                        }

                        <h3>systemd services (@vmSvc.SystemdServices.Count)</h3>
                        @if (vmSvc.SystemdServices.Count == 0)
                        {
                            <p class="muted">No systemd services recorded (run discovery on this host).</p>
                        }
                        else
                        {
                            <ul class="topology-detail-items">
                                @foreach (var unit in vmSvc.SystemdServices)
                                {
                                    <li class="vm-service-row" @key="unit.Name">
                                        <div class="vm-service-head">
                                            <strong class="mono">@unit.Name</strong>
                                            <div class="vm-service-badges">
                                                <span class="ui-badge @(unit.IsOsService ? "neutral" : "soft")">@(unit.IsOsService ? "OS" : "Service")</span>
                                                @if (unit.HasListeners)
                                                {
                                                    <span class="ui-badge warn">Listening</span>
                                                }
                                            </div>
                                        </div>
                                        <span class="muted vm-service-meta">
                                            @unit.UptimeText
                                            @if (unit.MainPid > 0)
                                            {
                                                <span class="mono"> · PID @unit.MainPid</span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_vmSnapshot is { } vmPorts && _inspectorTab == InspectorTab.Ports)
                    {
                        var visiblePorts = vmPorts.Ports
                            .Where(item => _portFilter is null || item.Exposure == _portFilter)
                            .ToArray();

                        <div class="segmented-control vm-subfilter" role="group" aria-label="Filter ports by exposure">
                            <button type="button" class="@(_portFilter is null ? "active" : null)" @onclick="() => _portFilter = null">All (@vmPorts.Ports.Count)</button>
                            <button type="button" class="@(_portFilter == PortExposure.External ? "active" : null)" @onclick="() => _portFilter = PortExposure.External">External (@vmPorts.Ports.Count(p => p.Exposure == PortExposure.External))</button>
                            <button type="button" class="@(_portFilter == PortExposure.Private ? "active" : null)" @onclick="() => _portFilter = PortExposure.Private">Private (@vmPorts.Ports.Count(p => p.Exposure == PortExposure.Private))</button>
                            <button type="button" class="@(_portFilter == PortExposure.Internal ? "active" : null)" @onclick="() => _portFilter = PortExposure.Internal">Internal (@vmPorts.Ports.Count(p => p.Exposure == PortExposure.Internal))</button>
                        </div>

                        @if (visiblePorts.Length == 0)
                        {
                            <p class="muted">No listening ports in this category.</p>
                        }
                        else
                        {
                            <ul class="topology-detail-items">
                                @foreach (var port in visiblePorts)
                                {
                                    <li class="vm-service-row" @key="@($"{port.Protocol}|{port.Address}|{port.Port}")">
                                        <div class="vm-service-head">
                                            <strong class="mono">@port.Address:@port.Port/@port.Protocol</strong>
                                            <span class="ui-badge @ExposureBadgeClass(port.Exposure)">@port.ExposureLabel</span>
                                        </div>
                                        <div class="vm-service-foot">
                                            <span class="muted">@(string.IsNullOrWhiteSpace(port.OwnerName) ? "unknown process" : port.OwnerName)</span>
                                            @if (!string.IsNullOrWhiteSpace(port.FirewallNote))
                                            {
                                                <span class="mono muted">@port.FirewallNote</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_vmSnapshot is { } vmProcs && _inspectorTab == InspectorTab.Processes)
                    {
                        var filteredProcs = FilterProcesses(vmProcs.Processes);

                        <div class="segmented-control vm-subfilter" role="group" aria-label="Filter processes by tag">
                            <button type="button" class="@(_processCategoryFilter is null ? "active" : null)" @onclick="() => _processCategoryFilter = null">All (@vmProcs.Processes.Count)</button>
                            <button type="button" class="@(_processCategoryFilter == ProcessCategory.Service ? "active" : null)" @onclick="() => _processCategoryFilter = ProcessCategory.Service">Service (@vmProcs.Processes.Count(p => p.Category == ProcessCategory.Service))</button>
                            <button type="button" class="@(_processCategoryFilter == ProcessCategory.Docker ? "active" : null)" @onclick="() => _processCategoryFilter = ProcessCategory.Docker">Docker (@vmProcs.Processes.Count(p => p.Category == ProcessCategory.Docker))</button>
                            <button type="button" class="@(_processCategoryFilter == ProcessCategory.Os ? "active" : null)" @onclick="() => _processCategoryFilter = ProcessCategory.Os">OS (@vmProcs.Processes.Count(p => p.Category == ProcessCategory.Os))</button>
                        </div>

                        <div class="vm-process-toolbar">
                            <div class="field">
                                <label for="vm-proc-search" class="visually-hidden">Search processes</label>
                                <input id="vm-proc-search" type="search" @bind="_processQuery" @bind:event="oninput" placeholder="Filter PID, user, unit, command…" />
                            </div>
                            <div class="select-field">
                                <label for="vm-proc-sort" class="visually-hidden">Sort processes</label>
                                <select id="vm-proc-sort" @bind="_processSort">
                                    <option value="cpu">Sort: CPU%</option>
                                    <option value="mem">Sort: RAM%</option>
                                    <option value="uptime">Sort: Uptime</option>
                                </select>
                            </div>
                        </div>

                        @if (vmProcs.TotalProcessCount > vmProcs.Processes.Count)
                        {
                            <p class="muted vm-proc-count">Showing top @vmProcs.Processes.Count active of @vmProcs.TotalProcessCount processes (secrets redacted).</p>
                        }

                        @if (filteredProcs.Count == 0)
                        {
                            <p class="muted">No processes recorded yet. Click <strong>Live refresh</strong> or <strong>Run discovery</strong>.</p>
                        }
                        else
                        {
                            <ul class="topology-detail-items">
                                @foreach (var proc in filteredProcs)
                                {
                                    <li class="vm-service-row" @key="proc.Pid">
                                        <div class="vm-service-head">
                                            <strong>@proc.Name <span class="mono muted">(@proc.Pid)</span></strong>
                                            <span class="ui-badge @ProcessBadgeClass(proc.Category)">@ProcessTagText(proc)</span>
                                        </div>
                                        <div class="vm-service-foot mono muted">
                                            <span>@proc.User · CPU @proc.CpuPercent.ToString("0.0", CultureInfo.InvariantCulture)% · RAM @proc.MemoryPercent.ToString("0.0", CultureInfo.InvariantCulture)%</span>
                                            @if (proc.ElapsedSeconds > 0)
                                            {
                                                <span>up @VmInspectorService.FormatDuration(TimeSpan.FromSeconds(proc.ElapsedSeconds))</span>
                                            }
                                        </div>
                                        <span class="mono muted vm-proc-cmd">@proc.CommandLine</span>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    else if (_selected is JsonElement selected)
                    {
                        @RenderNetworkAndSelectionDetails(selected)
                    }
                    else
                    {
                        <p class="muted">Select a server card, node, or edge on the map, or open the Index tab.</p>
                    }
                        </div>
                    </aside>
                }
            </div>

            <div class="topology-overlay-bottom">
                <div class="topology-map-header">
                    <div>
                        <h2 id="topology-graph-title">Infrastructure map</h2>
                        <p class="muted">@GraphSummary</p>
                    </div>
                </div>

                @* Bottom-right floating map zoom/fit/fullscreen controls. *@
                <div class="topology-float-controls" role="group" aria-label="Map zoom and layout">
                    <button class="ui-button secondary icon-button" type="button" @onclick="ZoomOutAsync" disabled="@(_graphModule is null)" aria-label="Zoom out" title="Zoom out">−</button>
                    <button class="ui-button secondary icon-button" type="button" @onclick="ZoomInAsync" disabled="@(_graphModule is null)" aria-label="Zoom in" title="Zoom in">+</button>
                    <button class="ui-button secondary" type="button" @onclick="FitGraphAsync" disabled="@(_graphModule is null)">Fit</button>
                    <button class="ui-button secondary" type="button" @onclick="ToggleFullscreenAsync" aria-pressed="@_fullscreen">
                        @(_fullscreen ? "Exit full" : "Fullscreen")
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private const string ClientsCardId = "servers-view:clients";
    private const string UnknownHostCardPrefix = "servers-view:unknown:";

    private enum TopologyView { Servers, Service, Network }
    private enum InspectorTab { Overview, Services, Ports, Processes, Network, Index }

    private ElementReference _graphHost;
    private IJSObjectReference? _graphModule;
    private DotNetObjectReference<Topology>? _dotNetReference;
    private Snapshot? _snapshot;
    private Snapshot? _latestRun;
    private GraphSnapshotDto? _graph;
    private IReadOnlyList<ServerSummary> _servers = [];
    private IReadOnlyList<JsonElement> _visibleNodes = [];
    private JsonElement? _selected;
    private string? _selectedId;
    private string _search = string.Empty;
    private string _selectedTag = string.Empty;
    private string _selectedProject = string.Empty;
    private string _selectedSubnet = string.Empty;
    private string _traceQuery = string.Empty;
    private string? _traceMessage;
    private IReadOnlySet<string> _tracedNodeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _tracedEdgeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposeCts = new();
    private string? _pageError;
    private string? _progressMessage;
    private bool _discovering => Discovery.IsRunning;
    private int _completedServers;

    private bool _discoveryExpanded;
    private bool _detailsOpen;
    private bool _fullscreen;
    private InspectorTab _inspectorTab = InspectorTab.Overview;
    private VmInspectorSnapshot? _vmSnapshot;
    private bool _vmLoading;
    private bool _vmRefreshing;
    private string? _vmError;
    private PortExposure? _portFilter;
    private ProcessCategory? _processCategoryFilter;
    private string _processQuery = string.Empty;
    private string _processSort = "cpu";

    private TopologyView CurrentView { get; set; } = TopologyView.Servers;
    private GraphView CurrentGraphView => CurrentView == TopologyView.Network ? GraphView.Network : GraphView.Service;
    private IReadOnlyList<string> _tags = [];
    private IReadOnlyList<string> _projects = [];
    private IReadOnlyList<string> _subnets = [];
    private IReadOnlyList<GraphListenerDto> _selectedListeners = [];
    private IReadOnlyList<GraphEvidenceDto> _selectedEvidence = [];
    private IReadOnlyDictionary<string, string> _serverAlertStatuses = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    private int ActiveFilterCount =>
        (!string.IsNullOrEmpty(_selectedTag) ? 1 : 0)
        + (!string.IsNullOrEmpty(_selectedProject) ? 1 : 0)
        + (!string.IsNullOrEmpty(_selectedSubnet) ? 1 : 0)
        + (_tracedNodeIds.Count > 0 ? 1 : 0);

    private RenderFragment RenderNodeAttributes(JsonElement selected) => @<dl class="topology-detail-list">
        <dt>Kind</dt><dd>@ReadString(selected, "kind")</dd>
        @if (ReadValue(selected, "port") is string port)
        {
            <dt>Port</dt><dd class="mono">:@port @ReadString(selected, "protocol")</dd>
        }
        @if (IsEdge(selected) && ReadString(selected, "ports") is { Length: > 0 } ports)
        {
            <dt>Ports</dt><dd class="mono">@ports</dd>
        }
        @if (IsEdge(selected) && ReadString(selected, "source") is string sourceId && ReadString(selected, "target") is string targetId)
        {
            <dt>Source</dt><dd>@EndpointName(sourceId)</dd>
            <dt>Target</dt><dd>@EndpointName(targetId)</dd>
        }
        @if (!IsEdge(selected) && selected.TryGetProperty("attributes", out var attributes) && attributes.ValueKind == JsonValueKind.Object)
        {
            @foreach (var property in attributes.EnumerateObject().Where(property => property.Value.ValueKind is JsonValueKind.String or JsonValueKind.Number
                && property.Name != StaleCarryForward.LastSeenAttribute))
            {
                <dt>@Humanize(property.Name)</dt><dd class="@(property.Name.Contains("ip", StringComparison.OrdinalIgnoreCase) || property.Name.Contains("address", StringComparison.OrdinalIgnoreCase) ? "mono" : null)">@property.Value.ToString()</dd>
            }
        }
    </dl>;

    private RenderFragment RenderNetworkAndSelectionDetails(JsonElement selected) => @<div class="vm-network-tab">
        @if (!IsEdge(selected) && selected.TryGetProperty("attributes", out var staleAttributes)
            && StaleCarryForward.Badge(staleAttributes) is string staleBadge)
        {
            <p class="topology-stale-note"><span class="ui-badge warn">@staleBadge</span>
                <span class="muted">The server could not be reached or logged into at the last discovery (see Servers for the cause); this is its last known state.</span></p>
        }
        else if (IsEdge(selected) && (ReadBool(selected, "stale") || string.Equals(ReadString(selected, "stale"), "stale", StringComparison.Ordinal)))
        {
            <p class="topology-stale-note"><span class="ui-badge warn">@(ReadString(selected, "staleText") ?? StaleCarryForward.StaleEdgeBadge)</span>
                <span class="muted">@StaleCarryForward.StaleEdgeEvidenceDescription</span></p>
        }

        @RenderNodeAttributes(selected)

        @if (SelectedSsh is { } ssh)
        {
            <h3>SSH sessions</h3>
            @if (ssh.Rows.Count == 0)
            {
                <p class="muted">No SSH sessions were open at the last discovery.</p>
            }
            else
            {
                <p class="topology-ssh-status"><span class="ui-badge @SshLevelBadge(ssh.Status.Level)">@SshLevelText(ssh.Status)</span></p>
                <ul class="topology-detail-items topology-ssh-sessions">
                    @foreach (var row in ssh.Rows)
                    {
                        <li @key="@($"{row.Address}|{row.Verdict}")">
                            <span class="topology-ssh-source">
                                <span class="mono">@row.Address</span>
                                @if (row.ServerName is not null)
                                {
                                    <span class="muted">@row.ServerName</span>
                                }
                            </span>
                            <span class="topology-ssh-meta">
                                <span class="muted">× @row.Count @(row.Count == 1 ? "session" : "sessions")</span>
                                <span class="ui-badge @SshVerdictBadge(row.Verdict)">@SshVerdictText(row.Verdict)</span>
                            </span>
                        </li>
                    }
                </ul>
            }
            @if (ssh.AllowedSources.Count == 0)
            {
                <p class="muted">Set the allowed SSH sources to be warned about other addresses.</p>
            }
            <a class="ui-button secondary topology-ssh-link" href="/servers?sshSources=@ssh.ServerId">Allowed SSH sources</a>
        }
        @if (_selectedListeners.Count > 0)
        {
            <h3>Listeners</h3>
            <ul class="topology-detail-items">
                @foreach (var listener in _selectedListeners)
                {
                    <li><span class="mono">@listener.Address:@listener.Port/@listener.Protocol</span><span class="muted">@listener.ProcessName</span></li>
                }
            </ul>
        }
        @if (SelectedMemberConnections.Count > 0)
        {
            <h3>Connections</h3>
            <ul class="topology-detail-items">
                @foreach (var connection in SelectedMemberConnections)
                {
                    <li>
                        <span>@connection.Source → @connection.Target <span class="mono">@(connection.Port is null ? string.Empty : $":{connection.Port}")</span></span>
                        <span class="ui-badge neutral">@connection.Kind</span>
                    </li>
                }
            </ul>
        }
        @if (ReadString(selected, "kind") == "Unknown")
        {
            <h3>Connections</h3>
            @if (SelectedConnections.Count > 0)
            {
                <ul class="topology-detail-items">
                    @foreach (var connection in SelectedConnections)
                    {
                        <li>
                            <span>@connection.Direction @connection.PeerName</span>
                            <span class="mono">@(connection.Port is null ? "port unknown" : $":{connection.Port}")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">No connecting graph edges are recorded for this endpoint.</p>
            }
            @if (InventoryServerOf(selected) is not null)
            {
                <p class="muted">This server is in the inventory; run discovery to map it.</p>
            }
            else if (TryGetProperty(selected, "attributes", out var unknownAttributes)
                && ReadValue(unknownAttributes, "address") is not null
                && ReadString(selected, "serverId") is not null)
            {
                <button class="ui-button primary" type="button" @onclick="() => AddUnknownServerAsync(selected)">Add this server</button>
            }
        }
        @if (_selectedEvidence.Count > 0)
        {
            <h3>Evidence</h3>
            <ul class="topology-detail-items">
                @foreach (var evidence in _selectedEvidence)
                {
                    <li><span class="ui-badge neutral">@evidence.Collector</span><span>@evidence.Description</span></li>
                }
            </ul>
        }
        @if (IsEdge(selected) && _selectedEvidence.Count == 0)
        {
            <p class="muted">No collector evidence is attached to this edge.</p>
        }
    </div>;

    private IReadOnlyList<UnknownConnection> SelectedConnections
    {
        get
        {
            if (_graph is null || _selected is not JsonElement selected || !IsUnknown(selected) || ReadString(selected, "id") is not string unknownId) return [];
            var ids = new HashSet<string>(ReadStringList(selected, "memberNodeIds"), StringComparer.OrdinalIgnoreCase) { unknownId };
            return _graph.Edges.Select(edge => edge.Data)
                .Where(edge => ids.Contains(ReadString(edge, "source") ?? "") || ids.Contains(ReadString(edge, "target") ?? ""))
                .Select(edge => ids.Contains(ReadString(edge, "source") ?? "")
                    ? new UnknownConnection("Connects to", EndpointName(ReadString(edge, "target") ?? "") ?? "Unknown endpoint", ReadValue(edge, "port"))
                    : new UnknownConnection("Connected from", EndpointName(ReadString(edge, "source") ?? "") ?? "Unknown endpoint", ReadValue(edge, "port")))
                .ToArray();
        }
    }

    private IReadOnlyList<EdgeConnection> SelectedMemberConnections
    {
        get
        {
            if (_graph is null || _selected is not JsonElement selected || !IsEdge(selected)) return [];
            var members = MemberEdgeIds(selected);
            return members.Count == 0
                ? []
                : _graph.Edges.Select(edge => edge.Data)
                    .Where(edge => Guid.TryParseExact(ReadString(edge, "id"), "N", out var id) && members.Contains(id))
                    .Select(edge => new EdgeConnection(EndpointName(ReadString(edge, "source") ?? "") ?? "Unknown",
                        EndpointName(ReadString(edge, "target") ?? "") ?? "Unknown", ReadValue(edge, "port"), ReadString(edge, "kind") ?? string.Empty))
                    .ToArray();
        }
    }

    private IReadOnlyList<JsonElement> VisibleEdges => _graph is null ? [] : _graph.Edges
        .Select(edge => edge.Data)
        .Where(edge => ReadString(edge, "source") is string source && ReadString(edge, "target") is string target
            && _visibleNodes.Any(node => ReadString(node, "id") == source)
            && _visibleNodes.Any(node => ReadString(node, "id") == target))
        .ToArray();

    private string SelectedTitle => _selected is JsonElement selected && IsEdge(selected)
        ? $"{EndpointName(ReadString(selected, "source") ?? "") ?? "Source"} {(MemberEdgeIds(selected).Count > 0 ? "↔" : "→")} {EndpointName(ReadString(selected, "target") ?? "") ?? "Target"}"
        : _selected is JsonElement node && ReadString(node, "id") is string cardId && cardId.StartsWith(UnknownHostCardPrefix, StringComparison.Ordinal)
            ? InventoryServerOf(node)?.Name ?? UnknownHostTitle(UnknownHostAddress(node), ReadBool(node, "external"))
        : _vmSnapshot is not null && !IsEdge(_selected ?? default) && ReadString(_selected ?? default, "kind") == "Host"
            ? _vmSnapshot.ServerName
        : _selected is JsonElement other ? ReadString(other, "label") ?? ReadString(other, "kind") ?? "Selected node" : "Map index";

    private int ProgressPercent => _servers.Count == 0 ? (_discovering ? 15 : 0) : _completedServers * 100 / _servers.Count;
    private string GraphSummary => _graph is null
        ? "Run discovery to build a map of your servers and services."
        : $"{_visibleNodes.Count} nodes · {VisibleEdgeCount} connections";

    private int VisibleEdgeCount
    {
        get
        {
            if (_graph is null) return 0;
            var ids = _visibleNodes.Select(node => ReadString(node, "id")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return _graph.Edges.Count(edge => ReadString(edge.Data, "source") is string source
                && ReadString(edge.Data, "target") is string target && ids.Contains(source) && ids.Contains(target));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Discovery.StateChanged += HandleDiscoveryStateChanged;
        _servers = await ServersService.ListAsync(CancellationToken.None);
        var activeAlerts = await AlertManager.ListAsync(null, CancellationToken.None);
        _serverAlertStatuses = activeAlerts.Where(alert => alert.ServerId is not null && alert.State != AlertState.Resolved)
            .GroupBy(alert => alert.ServerId!.Value.ToString("N"), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.OrderByDescending(alert => alert.Severity).First().Severity.ToString(), StringComparer.OrdinalIgnoreCase);
        _snapshot = await SnapshotRepository.GetLatestAsync(CancellationToken.None);
        _latestRun = await SnapshotRepository.GetLatestRunAsync(CancellationToken.None);
        if (_snapshot is not null)
        {
            await LoadGraphAsync(_snapshot.Id);
        }
    }

    [SupplyParameterFromQuery(Name = "node")]
    public string? FocusNodeId { get; set; }

    private string? _focusedNodeId;

    protected override async Task OnParametersSetAsync()
    {
        if (_graphModule is not null) await FocusRequestedNodeAsync();
    }

    private async Task FocusRequestedNodeAsync()
    {
        if (string.IsNullOrWhiteSpace(FocusNodeId) || FocusNodeId == _focusedNodeId || _graphModule is null || _graph is null) return;
        if (_visibleNodes.FirstOrDefault(node => string.Equals(ReadString(node, "id"), FocusNodeId, StringComparison.OrdinalIgnoreCase)) is not { ValueKind: JsonValueKind.Object } node)
        {
            _pageError = "That item is not in the latest discovery snapshot. Run discovery to refresh the map.";
            return;
        }

        _focusedNodeId = FocusNodeId;
        await SelectEntityAsync(node);
        await _graphModule.InvokeVoidAsync("focus", FocusNodeId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _graphModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/graph.js");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _graphModule.InvokeVoidAsync("init", _graphHost, _dotNetReference);
            await PushGraphAsync();
            await FocusRequestedNodeAsync();
            StateHasChanged();
        }
        catch (JSException exception)
        {
            _pageError = $"The graph could not be initialized: {exception.Message}";
            StateHasChanged();
        }
    }

    private void OpenInspectorIndex()
    {
        _detailsOpen = true;
        if (_selected is null) _inspectorTab = InspectorTab.Index;
    }

    private void CloseDrawer() => _detailsOpen = false;

    private async Task ToggleFullscreenAsync()
    {
        _fullscreen = !_fullscreen;
        if (_graphModule is not null)
        {
            await Task.Delay(50);
            await _graphModule.InvokeVoidAsync("fit");
        }
    }

    private async Task HandleStageKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            if (_detailsOpen) _detailsOpen = false;
            else if (_discoveryExpanded) _discoveryExpanded = false;
            else if (_fullscreen) await ToggleFullscreenAsync();
        }
    }

    private async Task ChangeViewAsync(TopologyView view)
    {
        CurrentView = view;
        if (_snapshot is not null) await LoadGraphAsync(_snapshot.Id);
        await PushGraphAsync();
        if (_tracedNodeIds.Count > 0) await PushTraceAsync();
    }

    private async Task LoadGraphAsync(Guid snapshotId)
    {
        _graph = await GraphRepository.GetAsync(snapshotId, CurrentGraphView, CancellationToken.None);
        _inventory = null;
        _sshStatuses = null;
        _externalClientAddresses = null;
        _selected = null;
        _selectedId = null;
        _vmSnapshot = null;
        _vmError = null;
        _detailsOpen = false;
        _traceMessage = null;
        _tracedNodeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _tracedEdgeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        UpdateOptions();
        UpdateVisibleNodes();
    }

    private async Task RunDiscoveryAsync()
    {
        if (Discovery.IsRunning) return;
        _pageError = null;
        _completedServers = 0;
        _progressMessage = "Preparing discovery…";
        try
        {
            var progress = new Progress<DiscoveryProgress>(item =>
            {
                if (_disposeCts.IsCancellationRequested) return;
                if (item.Stage == DiscoveryProgressStage.ServerCompleted) _completedServers++;
                _progressMessage = item.Message ?? item.Stage switch
                {
                    DiscoveryProgressStage.Started => "Discovery started…",
                    DiscoveryProgressStage.ServerStarted => $"Collecting from {item.ServerName}…",
                    DiscoveryProgressStage.CollectorStarted => $"{item.ServerName}: running {item.CollectorName}…",
                    DiscoveryProgressStage.CollectorCompleted => $"{item.ServerName}: {item.CollectorName} complete",
                    DiscoveryProgressStage.ServerCompleted => $"{item.ServerName} complete",
                    _ => "Finalizing topology…"
                };
                _ = InvokeAsync(StateHasChanged);
            });
            _snapshot = await Discovery.RunAsync(progress, _disposeCts.Token);
            _latestRun = _snapshot;
            await LoadGraphAsync(_snapshot.Id);
            _progressMessage = $"Discovery finished: {_snapshot.SucceededServerCount} succeeded, {_snapshot.FailedServerCount} failed.";
            await PushGraphAsync();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _pageError = $"Discovery failed: {exception.Message}";
        }
    }

    private void HandleDiscoveryStateChanged()
    {
        if (_disposeCts.IsCancellationRequested) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        await ApplySearchAsync();
    }

    private Task ApplySearchAsync() => _graphModule is null
        ? Task.CompletedTask
        : _graphModule.InvokeVoidAsync("search", _search).AsTask();

    private async Task TagChanged(ChangeEventArgs args)
    {
        _selectedTag = args.Value?.ToString() ?? string.Empty;
        UpdateVisibleNodes();
        await PushGraphAsync();
    }

    private async Task ProjectChanged(ChangeEventArgs args)
    {
        _selectedProject = args.Value?.ToString() ?? string.Empty;
        UpdateVisibleNodes();
        await PushGraphAsync();
    }

    private async Task SubnetChanged(ChangeEventArgs args)
    {
        _selectedSubnet = args.Value?.ToString() ?? string.Empty;
        UpdateVisibleNodes();
        await PushGraphAsync();
    }

    private void UpdateOptions()
    {
        if (_graph is null)
        {
            _tags = [];
            _projects = [];
            _subnets = [];
            return;
        }

        _tags = _graph.Nodes.Select(element => element.Data)
            .Where(data => ReadString(data, "kind") == "Host" && TryGetProperty(data, "attributes", out _))
            .SelectMany(data => TryGetProperty(data.GetProperty("attributes"), "tags", out var tags) && tags.ValueKind == JsonValueKind.Array
                ? tags.EnumerateArray().Where(tag => tag.ValueKind == JsonValueKind.String).Select(tag => tag.GetString()!)
                : [])
            .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
        _projects = _graph.Nodes.Select(element => element.Data)
            .Select(data => TryGetProperty(data, "attributes", out var attributes) ? ReadString(attributes, "composeProject") : null)
            .Where(project => !string.IsNullOrWhiteSpace(project))
            .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).Select(project => project!).ToArray();
        var hostSubnets = _graph.Nodes.Select(element => element.Data)
            .Where(data => ReadString(data, "kind") == "Host" && TryGetProperty(data, "attributes", out _))
            .SelectMany(data => TryGetProperty(data.GetProperty("attributes"), "subnets", out var subnets) && subnets.ValueKind == JsonValueKind.Array
                ? subnets.EnumerateArray().Where(subnet => subnet.ValueKind == JsonValueKind.String).Select(subnet => subnet.GetString()!)
                : []);
        var subnetNodes = _graph.Nodes.Select(element => element.Data)
            .Where(data => ReadString(data, "kind") == "Subnet")
            .Select(data => ReadString(data, "label"))
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .Select(label => label!);
        _subnets = hostSubnets.Concat(subnetNodes)
            .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
    }

    private void UpdateVisibleNodes()
    {
        if (_graph is null)
        {
            _visibleNodes = [];
            return;
        }

        var nodes = _graph.Nodes.Select(element => element.Data).ToArray();
        var taggedServerIds = string.IsNullOrEmpty(_selectedTag)
            ? null
            : nodes.Where(node => ReadString(node, "kind") == "Host" && HasTag(node, _selectedTag))
                .Select(node => ReadString(node, "serverId")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var projectServerIds = string.IsNullOrEmpty(_selectedProject)
            ? null
            : nodes.Where(node => HasProject(node, _selectedProject))
                .Select(node => ReadString(node, "serverId")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
        HashSet<string>? subnetServerIds = null;
        if (!string.IsNullOrEmpty(_selectedSubnet))
        {
            subnetServerIds = nodes.Where(node => ReadString(node, "kind") == "Host" && HasSubnet(node, _selectedSubnet))
                .Select(node => ReadString(node, "serverId")).Where(id => id is not null).Select(id => id!).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var matchingSubnetNodeIds = nodes.Where(node => ReadString(node, "kind") == "Subnet"
                    && string.Equals(ReadString(node, "label"), _selectedSubnet, StringComparison.OrdinalIgnoreCase))
                .Select(node => ReadString(node, "id")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
            if (matchingSubnetNodeIds.Count > 0)
            {
                var nodeById = nodes.Where(node => ReadString(node, "id") is not null)
                    .ToDictionary(node => ReadString(node, "id")!, StringComparer.OrdinalIgnoreCase);
                foreach (var edge in _graph.Edges.Select(element => element.Data))
                {
                    var source = ReadString(edge, "source");
                    var target = ReadString(edge, "target");
                    if (source is not null && target is not null && matchingSubnetNodeIds.Contains(target)
                        && nodeById.TryGetValue(source, out var connected) && ReadString(connected, "serverId") is { } connectedServerId)
                    {
                        subnetServerIds.Add(connectedServerId);
                    }
                }
            }
        }

        bool ServerMatches(JsonElement node)
        {
            var serverId = ReadString(node, "serverId");
            return serverId is not null && (taggedServerIds is null || taggedServerIds.Contains(serverId))
                && (projectServerIds is null || projectServerIds.Contains(serverId))
                && (subnetServerIds is null || subnetServerIds.Contains(serverId));
        }

        var hasFilter = taggedServerIds is not null || projectServerIds is not null || subnetServerIds is not null;
        var allowedIds = nodes.Where(node =>
                (ReadString(node, "kind") == "Host" && ServerMatches(node))
                || (ReadString(node, "kind") != "Host" && ReadString(node, "kind") != "Subnet" && ServerMatches(node)
                    && (string.IsNullOrEmpty(_selectedProject) || HasProject(node, _selectedProject))))
            .Select(node => ReadString(node, "id")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (hasFilter)
        {
            foreach (var edge in _graph.Edges.Select(element => element.Data))
            {
                var source = ReadString(edge, "source");
                var target = ReadString(edge, "target");
                if (source is not null && target is not null && (allowedIds.Contains(source) || allowedIds.Contains(target)))
                {
                    if (nodes.Any(node => ReadString(node, "id") == source && ReadString(node, "kind") == "Subnet"
                            && (string.IsNullOrEmpty(_selectedSubnet) || string.Equals(ReadString(node, "label"), _selectedSubnet, StringComparison.OrdinalIgnoreCase))))
                        allowedIds.Add(source);
                    if (nodes.Any(node => ReadString(node, "id") == target && ReadString(node, "kind") == "Subnet"
                            && (string.IsNullOrEmpty(_selectedSubnet) || string.Equals(ReadString(node, "label"), _selectedSubnet, StringComparison.OrdinalIgnoreCase))))
                        allowedIds.Add(target);
                }
            }
        }

        _visibleNodes = nodes.Where(node => !hasFilter
                || ReadString(node, "id") is string id && allowedIds.Contains(id))
            .ToArray();
        if (_selectedId is not null && !_visibleNodes.Any(node => string.Equals(ReadString(node, "id"), _selectedId, StringComparison.OrdinalIgnoreCase)))
        {
            _selected = null;
            _selectedId = null;
            _vmSnapshot = null;
            _selectedListeners = [];
            _selectedEvidence = [];
        }
    }

    private async Task PushGraphAsync()
    {
        if (_graphModule is null) return;
        var ids = _visibleNodes.Select(node => ReadString(node, "id")).Where(id => id is not null).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var elements = new List<JsonElement>();
        elements.AddRange(_visibleNodes);
        if (_graph is not null)
        {
            elements.AddRange(_graph.Edges.Select(edge => edge.Data).Where(edge =>
                ReadString(edge, "source") is string source && ReadString(edge, "target") is string target
                && ids.Contains(source) && ids.Contains(target)));
        }

        await _graphModule.InvokeVoidAsync("setData", elements, CurrentView.ToString().ToLowerInvariant(), _serverAlertStatuses, BuildServerInfo(),
            BuildListenerPorts(), Inventory);
        await _graphModule.InvokeVoidAsync("search", _search);
        await _graphModule.InvokeVoidAsync("setTheme");
    }

    private Task FitGraphAsync() => _graphModule is null ? Task.CompletedTask : _graphModule.InvokeVoidAsync("fit").AsTask();
    private Task ZoomInAsync() => _graphModule is null ? Task.CompletedTask : _graphModule.InvokeVoidAsync("zoomBy", 1.4).AsTask();
    private Task ZoomOutAsync() => _graphModule is null ? Task.CompletedTask : _graphModule.InvokeVoidAsync("zoomBy", 1 / 1.4).AsTask();

    private async Task TraceAsync()
    {
        if (_graph is null || string.IsNullOrWhiteSpace(_traceQuery))
        {
            _traceMessage = "Enter a domain name or URL to trace.";
            return;
        }

        if (CurrentView == TopologyView.Network)
        {
            CurrentView = TopologyView.Servers;
            if (_snapshot is not null) await LoadGraphAsync(_snapshot.Id);
            await PushGraphAsync();
        }

        var trace = GraphTraceResolver.Resolve(_graph, _traceQuery);
        if (trace is null)
        {
            _tracedNodeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            _tracedEdgeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            _traceMessage = $"No domain in this snapshot matches '{_traceQuery.Trim()}'.";
            if (_graphModule is not null) await _graphModule.InvokeVoidAsync("clearTrace");
            return;
        }

        _tracedNodeIds = trace.NodeIds;
        _tracedEdgeIds = trace.EdgeIds;
        _traceMessage = $"Trace for {trace.Hostname}: {trace.NodeIds.Count} nodes and {trace.EdgeIds.Count} connections.";
        await PushTraceAsync();
    }

    private async Task ClearTraceAsync()
    {
        _tracedNodeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _tracedEdgeIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _traceMessage = null;
        if (_graphModule is not null) await _graphModule.InvokeVoidAsync("clearTrace");
    }

    private Task PushTraceAsync() => _graphModule is null
        ? Task.CompletedTask
        : _graphModule.InvokeVoidAsync("highlightTrace", _tracedNodeIds.ToArray(), _tracedEdgeIds.ToArray()).AsTask();

