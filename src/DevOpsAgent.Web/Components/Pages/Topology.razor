    private async Task SelectEntityAsync(JsonElement entity)
    {
        var id = ReadString(entity, "id");
        if (id is null) return;
        _selectedId = id;
        _selected = entity;
        _detailsOpen = true;
        LoadSelectionDetails(entity);
        await LoadVmForSelectionAsync(entity);
        if (_graphModule is not null) await _graphModule.InvokeVoidAsync("select", id);
    }

    private void LoadSelectionDetails(JsonElement entity)
    {
        _selectedListeners = [];
        _selectedEvidence = [];
        if (_graph is null) return;
        if (IsEdge(entity))
        {
            var edgeIds = MemberEdgeIds(entity);
            if (edgeIds.Count == 0 && Guid.TryParseExact(ReadString(entity, "id"), "N", out var edgeId)) edgeIds = [edgeId];
            _selectedEvidence = _graph.Evidence.Where(item => item.EdgeId is Guid id && edgeIds.Contains(id)).ToArray();
        }
        else
        {
            var nodeIds = ReadGuidSet(entity, "memberNodeIds");
            if (Guid.TryParseExact(ReadString(entity, "id"), "N", out var nodeId)) nodeIds.Add(nodeId);
            _selectedListeners = _graph.Listeners.Where(listener => nodeIds.Contains(listener.NodeId)).ToArray();
            _selectedEvidence = _graph.Evidence.Where(item => item.NodeId is Guid id && nodeIds.Contains(id)).ToArray();
        }
    }

    private async Task LoadVmForSelectionAsync(JsonElement entity)
    {
        _vmError = null;
        if (!TryResolveServerId(entity, out var serverId))
        {
            _vmSnapshot = null;
            if (_inspectorTab is not InspectorTab.Network and not InspectorTab.Index)
            {
                _inspectorTab = InspectorTab.Network;
            }
            return;
        }

        if (_inspectorTab == InspectorTab.Index)
        {
            _inspectorTab = InspectorTab.Overview;
        }

        if (_vmSnapshot?.ServerId == serverId)
        {
            return;
        }

        _vmLoading = true;
        try
        {
            _vmSnapshot = await VmInspector.LoadAsync(serverId, _disposeCts.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _vmError = $"Could not load VM details: {exception.Message}";
        }
        finally
        {
            _vmLoading = false;
        }
    }

    private async Task RefreshLiveVmAsync(Guid serverId)
    {
        if (_vmRefreshing) return;
        _vmRefreshing = true;
        _vmError = null;
        try
        {
            _vmSnapshot = await VmInspector.RefreshLiveAsync(serverId, _disposeCts.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _vmError = $"Live refresh failed: {exception.Message}";
        }
        finally
        {
            _vmRefreshing = false;
        }
    }

    private bool TryResolveServerId(JsonElement entity, out Guid serverId)
    {
        serverId = Guid.Empty;
        if (IsEdge(entity)) return false;

        var kind = ReadString(entity, "kind");
        if (string.Equals(kind, "Unknown", StringComparison.OrdinalIgnoreCase))
        {
            if (InventoryServerOf(entity) is { } known && Guid.TryParseExact(known.ServerId, "N", out serverId))
            {
                return true;
            }
            return false;
        }

        if (ReadString(entity, "inventoryServerId") is { } invId && Guid.TryParseExact(invId, "N", out serverId))
        {
            return true;
        }

        if (ReadString(entity, "serverId") is { } rawId
            && Guid.TryParseExact(rawId, "N", out serverId)
            && ServerById(rawId) is not null)
        {
            return true;
        }

        return false;
    }

    private IReadOnlyList<ProcessInfo> FilterProcesses(IReadOnlyList<ProcessInfo> processes)
    {
        IEnumerable<ProcessInfo> query = processes.Where(item => _processCategoryFilter is null || item.Category == _processCategoryFilter);
        if (!string.IsNullOrWhiteSpace(_processQuery))
        {
            var term = _processQuery.Trim();
            query = query.Where(item =>
                item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || item.CommandLine.Contains(term, StringComparison.OrdinalIgnoreCase)
                || item.User.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (item.UnitName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (item.ContainerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || item.Pid.ToString(CultureInfo.InvariantCulture).Contains(term, StringComparison.Ordinal));
        }

        query = _processSort switch
        {
            "mem" => query.OrderByDescending(item => item.MemoryPercent).ThenByDescending(item => item.CpuPercent),
            "uptime" => query.OrderByDescending(item => item.ElapsedSeconds).ThenByDescending(item => item.CpuPercent),
            _ => query.OrderByDescending(item => item.CpuPercent).ThenByDescending(item => item.MemoryPercent)
        };

        return query.ToArray();
    }

