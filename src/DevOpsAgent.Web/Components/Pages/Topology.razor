    private static string FormatPercent(double? value) =>
        value is { } pct ? $"{pct.ToString("0.#", CultureInfo.InvariantCulture)}%" : "—";

    private static int BarWidth(double? value) =>
        value is { } pct ? (int)Math.Clamp(Math.Round(pct), 0, 100) : 0;

    private static string ProgressClass(double? value) =>
        value is >= 85 ? "high-load" : string.Empty;

    private static string FormatLoad(VmResourceMetrics resources) =>
        resources.Load1m is { } l1
            ? $"{l1.ToString("0.00", CultureInfo.InvariantCulture)} / {(resources.Load5m ?? 0).ToString("0.00", CultureInfo.InvariantCulture)}"
            : "—";

    private static string FormatBytesPair(double? used, double? total)
    {
        if (used is not { } u || total is not { } t || t <= 0) return "No metric sample yet";
        return $"{FormatBytes(u)} / {FormatBytes(t)}";
    }

    private static string FormatBytes(double bytes)
    {
        const double GiB = 1024d * 1024d * 1024d;
        const double MiB = 1024d * 1024d;
        return bytes >= GiB
            ? $"{(bytes / GiB).ToString("0.1", CultureInfo.InvariantCulture)} GB"
            : $"{(bytes / MiB).ToString("0", CultureInfo.InvariantCulture)} MB";
    }

    private static string FormatRate(double? bytesPerSec)
    {
        if (bytesPerSec is not { } rate) return "—";
        const double MiB = 1024d * 1024d;
        const double KiB = 1024d;
        if (rate >= MiB) return $"{(rate / MiB).ToString("0.1", CultureInfo.InvariantCulture)} MB/s";
        if (rate >= KiB) return $"{(rate / KiB).ToString("0", CultureInfo.InvariantCulture)} KB/s";
        return $"{rate.ToString("0", CultureInfo.InvariantCulture)} B/s";
    }

