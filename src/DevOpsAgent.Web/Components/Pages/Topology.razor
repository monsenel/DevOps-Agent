    private static HashSet<Guid> MemberEdgeIds(JsonElement edge) => ReadGuidSet(edge, "memberEdgeIds");

    private static HashSet<Guid> ReadGuidSet(JsonElement element, string property) => ReadStringList(element, property)
        .Select(value => Guid.TryParseExact(value, "N", out var id) ? id : Guid.Empty).Where(id => id != Guid.Empty).ToHashSet();

    private static IEnumerable<string> ReadStringList(JsonElement element, string property) => TryGetProperty(element, property, out var values) && values.ValueKind == JsonValueKind.Array
        ? values.EnumerateArray().Where(value => value.ValueKind == JsonValueKind.String).Select(value => value.GetString()!)
        : [];

    private static string UnknownHostAddress(JsonElement card) => TryGetProperty(card, "attributes", out var attributes) && ReadString(attributes, "Address") is { Length: > 0 } address
        ? address
        : (ReadString(card, "id") ?? string.Empty)[UnknownHostCardPrefix.Length..];

    private static string UnknownHostTitle(string address, bool external) => $"{(external ? "External client" : "Unknown host")} · {address}";

    private IReadOnlySet<string>? _externalClientAddresses;
    private IReadOnlySet<string> ExternalClientAddresses => _externalClientAddresses ??= BuildExternalClientAddresses();

    private IReadOnlySet<string> BuildExternalClientAddresses()
    {
        var sources = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var targets = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var edge in (_graph?.Edges ?? []).Select(item => item.Data))
        {
            if (ReadString(edge, "source") is { } source) sources.Add(source);
            if (ReadString(edge, "target") is { } target) targets.Add(target);
        }

        var clientByAddress = new Dictionary<string, bool>(StringComparer.Ordinal);
        foreach (var node in (_graph?.Nodes ?? []).Select(item => item.Data).Where(IsUnknown))
        {
            if (!TryGetProperty(node, "attributes", out var attributes) || ReadString(attributes, "address") is not { Length: > 0 } address
                || ReadString(node, "id") is not { } id) continue;
            var client = sources.Contains(id) && !targets.Contains(id);
            var key = NormalizeAddress(address);
            clientByAddress[key] = clientByAddress.GetValueOrDefault(key, true) && client;
        }

        return clientByAddress.Where(item => item.Value).Select(item => item.Key).ToHashSet(StringComparer.Ordinal);
    }

    private IReadOnlyDictionary<string, InventoryServer>? _inventory;
    private IReadOnlyDictionary<string, InventoryServer> Inventory => _inventory ??= BuildInventory();

    private static string NormalizeAddress(string address)
    {
        var text = address.Trim().ToLowerInvariant();
        if (text.StartsWith('[')) text = text[1..];
        if (text.EndsWith(']')) text = text[..^1];
        return text;
    }

    private IReadOnlyDictionary<string, InventoryServer> BuildInventory()
    {
        var result = new Dictionary<string, InventoryServer>(StringComparer.Ordinal);

        void Add(string text, InventoryServer server)
        {
            if (!System.Net.IPAddress.TryParse(text.Trim(), out var parsed) || System.Net.IPAddress.IsLoopback(parsed)) return;
            result.TryAdd(NormalizeAddress(text), server);
            result.TryAdd(NormalizeAddress(parsed.ToString()), server);
        }

        foreach (var server in _servers) Add(server.Host, new InventoryServer(server.Id.ToString("N"), server.Name));

        var claimed = new Dictionary<string, (string Address, HashSet<string> ServerIds)>(StringComparer.Ordinal);
        foreach (var node in (_graph?.Nodes ?? []).Select(element => element.Data).Where(node => ReadString(node, "kind") == "Host"))
        {
            if (ReadString(node, "serverId") is not { } serverId) continue;
            foreach (var address in ReadStringList(TryGetProperty(node, "attributes", out var attributes) ? attributes : default, "Addresses"))
            {
                var key = NormalizeAddress(address);
                if (!claimed.TryGetValue(key, out var claim)) claimed[key] = claim = (address, new HashSet<string>(StringComparer.OrdinalIgnoreCase));
                claim.ServerIds.Add(serverId);
            }
        }

        foreach (var (_, claim) in claimed.Where(item => item.Value.ServerIds.Count == 1))
        {
            var serverId = claim.ServerIds.Single();
            if (_servers.FirstOrDefault(server => string.Equals(server.Id.ToString("N"), serverId, StringComparison.OrdinalIgnoreCase)) is { } owner)
            {
                Add(claim.Address, new InventoryServer(serverId.ToLowerInvariant(), owner.Name));
            }
        }

        return result;
    }

    private InventoryServer? InventoryServerOf(JsonElement unknown)
    {
        if (ReadString(unknown, "inventoryServerId") is { } serverId
            && _servers.FirstOrDefault(server => string.Equals(server.Id.ToString("N"), serverId, StringComparison.OrdinalIgnoreCase)) is { } named)
        {
            return new InventoryServer(serverId, named.Name);
        }

        return TryGetProperty(unknown, "attributes", out var attributes) && ReadString(attributes, "address") is { } address
            && Inventory.TryGetValue(NormalizeAddress(address), out var entry) ? entry : null;
    }

    private Dictionary<string, int[]> BuildListenerPorts() => (_graph?.Listeners ?? [])
        .Where(listener => string.Equals(listener.Protocol, "tcp", StringComparison.OrdinalIgnoreCase) && !IsLoopbackOnly(listener.Address))
        .GroupBy(listener => listener.NodeId.ToString("N"), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => group.Select(listener => listener.Port).Distinct().Order().ToArray(), StringComparer.OrdinalIgnoreCase);

    private static bool IsLoopbackOnly(string address)
    {
        var text = address.Trim().Trim('[', ']');
        var scope = text.IndexOf('%');
        if (scope >= 0) text = text[..scope];
        if (!System.Net.IPAddress.TryParse(text, out var parsed)) return false;
        return System.Net.IPAddress.IsLoopback(parsed.IsIPv4MappedToIPv6 ? parsed.MapToIPv4() : parsed);
    }

    private Dictionary<string, object> BuildServerInfo() => _servers.ToDictionary(server => server.Id.ToString("N"),
        server => (object)new
        {
            os = server.OsInfo,
            address = CaptionAddress(server),
            ssh = SshStatuses.TryGetValue(server.Id.ToString("N"), out var status)
                ? new { level = status.Level.ToString().ToLowerInvariant(), summary = status.Summary }
                : new { level = "none", summary = string.Empty }
        },
        StringComparer.OrdinalIgnoreCase);

    private IReadOnlyDictionary<string, SshSessionStatus>? _sshStatuses;
    private IReadOnlyDictionary<string, SshSessionStatus> SshStatuses => _sshStatuses ??= BuildSshStatuses();

    private IReadOnlyDictionary<string, SshSessionStatus> BuildSshStatuses()
    {
        var result = new Dictionary<string, SshSessionStatus>(StringComparer.OrdinalIgnoreCase);
        foreach (var node in (_graph?.Nodes ?? []).Select(element => element.Data).Where(node => ReadString(node, "kind") == "Host"))
        {
            if (ReadString(node, "serverId") is { } serverId && ServerById(serverId) is { } server)
            {
                result[serverId] = AssessHost(node, server);
            }
        }

        return result;
    }

    private ServerSummary? ServerById(string serverId) =>
        _servers.FirstOrDefault(server => string.Equals(server.Id.ToString("N"), serverId, StringComparison.OrdinalIgnoreCase));

    private SshSessionStatus AssessHost(JsonElement host, ServerSummary server) => SshSessionAssessor.Assess(
        TryGetProperty(host, "attributes", out var attributes) ? SshSessionAttributes.Read(attributes) : [],
        server.AllowedSshSources, JumpHostAddresses(server));

    private IReadOnlyList<string> JumpHostAddresses(ServerSummary server)
    {
        if (server.JumpServerId is not { } jumpId || _servers.FirstOrDefault(candidate => candidate.Id == jumpId) is not { } jump) return [];

        var addresses = new List<string>();
        if (IsNonLoopbackIp(jump.Host)) addresses.Add(jump.Host.Trim());
        var jumpKey = jumpId.ToString("N");
        foreach (var node in (_graph?.Nodes ?? []).Select(element => element.Data)
                     .Where(node => ReadString(node, "kind") == "Host" && string.Equals(ReadString(node, "serverId"), jumpKey, StringComparison.OrdinalIgnoreCase)))
        {
            if (!TryGetProperty(node, "attributes", out var attributes)) continue;
            addresses.AddRange(ReadStringList(attributes, "Addresses").Where(IsNonLoopbackIp));
        }

        return addresses;
    }

    private static bool IsNonLoopbackIp(string text) => !text.Contains('/') && SshSourceList.TryNormalize(text, out var normalized)
        && !System.Net.IPAddress.IsLoopback(System.Net.IPAddress.Parse(normalized));

    private SshPanel? SelectedSsh
    {
        get
        {
            if (_selected is not JsonElement selected || IsEdge(selected) || ReadString(selected, "kind") != "Host"
                || ReadString(selected, "serverId") is not { } serverId || ServerById(serverId) is not { } server) return null;

            var status = SshStatuses.TryGetValue(serverId, out var known) ? known : AssessHost(selected, server);
            var rows = status.Sessions
                .GroupBy(item => (Address: item.Session.SourceAddress, item.Verdict))
                .Select(group => new SshRow(group.Key.Address,
                    Inventory.TryGetValue(NormalizeAddress(group.Key.Address), out var owner) ? owner.Name : null,
                    group.Sum(item => item.Session.Count), group.Key.Verdict))
                .ToArray();
            return new SshPanel(status, rows, server.AllowedSshSources, server.Id.ToString("N"));
        }
    }

    private static string SshLevelBadge(SshSessionLevel level) => level switch
    {
        SshSessionLevel.Warning => "danger",
        SshSessionLevel.Notice => "warn",
        _ => "neutral"
    };

    private static string SshLevelText(SshSessionStatus status) =>
        status.Level == SshSessionLevel.None ? "No other SSH sources" : status.Summary;

    private static string SshVerdictBadge(SshSessionVerdict verdict) => verdict switch
    {
        SshSessionVerdict.Allowed => "soft",
        SshSessionVerdict.NotAllowed => "danger",
        _ => "neutral"
    };

    private static string SshVerdictText(SshSessionVerdict verdict) => verdict switch
    {
        SshSessionVerdict.Agent => "DevOps Agent",
        SshSessionVerdict.AllowedImplicitly => "Jump server",
        SshSessionVerdict.Allowed => "Allowed",
        SshSessionVerdict.NotAllowed => "Not allowed",
        _ => "No list set"
    };

    private string CaptionAddress(ServerSummary server)
    {
        var addresses = HostAddresses(server.Id.ToString("N"));
        return addresses.Contains(server.Host, StringComparer.OrdinalIgnoreCase) ? server.Host : addresses.FirstOrDefault() ?? server.Host;
    }

    private IReadOnlyList<string> HostAddresses(string serverId) => (_graph?.Nodes ?? []).Select(element => element.Data)
        .Where(node => ReadString(node, "kind") == "Host" && string.Equals(ReadString(node, "serverId"), serverId, StringComparison.OrdinalIgnoreCase))
        .SelectMany(node => TryGetProperty(node, "attributes", out var attributes) && TryGetProperty(attributes, "addresses", out var addresses)
            && addresses.ValueKind == JsonValueKind.Array
                ? addresses.EnumerateArray().Where(address => address.ValueKind == JsonValueKind.String).Select(address => address.GetString()!)
                : [])
        .Select(text => (Text: text, Parsed: System.Net.IPAddress.TryParse(text, out var parsed) ? parsed : null))
        .Where(address => address.Parsed is not null && !System.Net.IPAddress.IsLoopback(address.Parsed) && !address.Parsed.IsIPv6LinkLocal)
        .OrderBy(address => address.Parsed!.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork ? 0 : 1)
        .Select(address => address.Text)
        .ToArray();

    [JSInvokable]
    public async Task OnGraphSelection(string? dataJson)
    {
        if (string.IsNullOrWhiteSpace(dataJson))
        {
            _selected = null;
            _selectedId = null;
            _vmSnapshot = null;
            _selectedListeners = [];
            _selectedEvidence = [];
            _detailsOpen = false;
        }
        else
        {
            using var document = JsonDocument.Parse(dataJson);
            var data = document.RootElement.Clone();
            _selected = data;
            _selectedId = ReadString(data, "id");
            _detailsOpen = true;
            LoadSelectionDetails(data);
            await LoadVmForSelectionAsync(data);
        }
        await InvokeAsync(StateHasChanged);
    }

    private static bool HasTag(JsonElement node, string tag) => TryGetProperty(node, "attributes", out var attributes)
        && TryGetProperty(attributes, "tags", out var tags) && tags.ValueKind == JsonValueKind.Array
        && tags.EnumerateArray().Any(value => value.ValueKind == JsonValueKind.String
            && string.Equals(value.GetString(), tag, StringComparison.OrdinalIgnoreCase));

    private static bool HasSubnet(JsonElement node, string subnet) => TryGetProperty(node, "attributes", out var attributes)
        && TryGetProperty(attributes, "subnets", out var subnets) && subnets.ValueKind == JsonValueKind.Array
        && subnets.EnumerateArray().Any(value => value.ValueKind == JsonValueKind.String
            && string.Equals(value.GetString(), subnet, StringComparison.OrdinalIgnoreCase));

    private static bool HasProject(JsonElement node, string project) => TryGetProperty(node, "attributes", out var attributes)
        && string.Equals(ReadString(attributes, "composeProject"), project, StringComparison.OrdinalIgnoreCase);

    private static string? ReadString(JsonElement element, string property) =>
        TryGetProperty(element, property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private static string? ReadValue(JsonElement element, string property) =>
        TryGetProperty(element, property, out var value) && value.ValueKind is JsonValueKind.String or JsonValueKind.Number
            ? value.ToString()
            : null;

    private static bool ReadBool(JsonElement element, string property) => TryGetProperty(element, property, out var value) && value.ValueKind == JsonValueKind.True;

    private static bool IsEdge(JsonElement element) => ReadString(element, "source") is not null
        && ReadString(element, "target") is not null;

    private static bool IsUnknown(JsonElement element) => string.Equals(ReadString(element, "kind"), "Unknown", StringComparison.OrdinalIgnoreCase);

    private static string PortLabel(JsonElement edge) => ReadString(edge, "port") is string port ? $":{port}" : string.Empty;

    private static bool TryGetProperty(JsonElement element, string property, out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var candidate in element.EnumerateObject())
            {
                if (string.Equals(candidate.Name, property, StringComparison.OrdinalIgnoreCase))
                {
                    value = candidate.Value;
                    return true;
                }
            }
        }
        value = default;
        return false;
    }

    private static string Humanize(string text) => System.Text.RegularExpressions.Regex.Replace(text, "([a-z])([A-Z])", "$1 $2");

    private sealed record UnknownConnection(string Direction, string PeerName, string? Port);
    private sealed record EdgeConnection(string Source, string Target, string? Port, string Kind);
    private sealed record InventoryServer(string ServerId, string Name);
    private sealed record SshPanel(SshSessionStatus Status, IReadOnlyList<SshRow> Rows, IReadOnlyList<string> AllowedSources, string ServerId);
    private sealed record SshRow(string Address, string? ServerName, int Count, SshSessionVerdict Verdict);

    private string? FindNodeName(string id) => _graph?.Nodes
        .Select(element => element.Data)
        .FirstOrDefault(data => string.Equals(ReadString(data, "id"), id, StringComparison.OrdinalIgnoreCase)) is JsonElement node
            ? ReadString(node, "label")
            : null;

    private string? EndpointName(string id) => id == ClientsCardId
        ? "Internet / Clients"
        : id.StartsWith(UnknownHostCardPrefix, StringComparison.Ordinal)
            ? Inventory.TryGetValue(id[UnknownHostCardPrefix.Length..], out var inventoryServer)
                ? inventoryServer.Name
                : UnknownHostTitle(id[UnknownHostCardPrefix.Length..], ExternalClientAddresses.Contains(id[UnknownHostCardPrefix.Length..]))
        : _graph?.Nodes.Select(element => element.Data)
            .FirstOrDefault(data => string.Equals(ReadString(data, "id"), id, StringComparison.OrdinalIgnoreCase)) is JsonElement node
                ? ReadString(node, "kind") == "Unknown" ? GraphNodeLabel.Describe(node) : ReadString(node, "label")
                : null;

    public async ValueTask DisposeAsync()
    {
        Discovery.StateChanged -= HandleDiscoveryStateChanged;
        _disposeCts.Cancel();
        _disposeCts.Dispose();
        _dotNetReference?.Dispose();
        if (_graphModule is not null)
        {
            try { await _graphModule.InvokeVoidAsync("dispose"); await _graphModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
