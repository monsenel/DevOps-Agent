@page "/servers"
@inject ServerService ServersService
@inject ServerCapabilityService CapabilityService
@inject DevOpsAgent.Application.Abstractions.IHostReachability Reachability
@inject IDiscoveryCoordinator Discovery
@inject NavigationManager Navigation
@inject DevOpsAgent.Application.Abstractions.ServerStateEvents StateEvents
@using Microsoft.AspNetCore.Components
@implements IDisposable
<PageTitle>Servers · DevOps Agent</PageTitle>

<div class="page-stack">
    <section class="ui-card servers-card" aria-labelledby="servers-title">
        <div class="servers-heading">
            <div>
                <p class="eyebrow">Inventory</p>
                <h2 id="servers-title">Servers</h2>
                <p class="muted">Manage the Linux hosts DevOps Agent can connect to.</p>
            </div>
            <div class="servers-heading-actions">
                <button class="ui-button secondary" type="button" @onclick="OpenImport">Import SSH config</button>
                <button class="ui-button primary" type="button" @onclick="OpenCreate">Add server</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_pageError))
        {
            <div class="alert-message error" role="alert">@_pageError</div>
        }

        @if (!string.IsNullOrWhiteSpace(_sourcesMessage))
        {
            <div class="settings-message success sources-saved-message" role="status">@_sourcesMessage</div>
        }

        @if (_servers.Count == 0)
        {
            <div class="servers-empty">
                <h3>No servers yet</h3>
                <p class="muted">Add a host to start building your inventory.</p>
                <button class="ui-button primary" type="button" @onclick="OpenCreate">Add server</button>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="servers-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Host</th>
                            <th scope="col">Group</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Jump server</th>
                            <th scope="col">Sudo</th>
                            <th scope="col">Last seen</th>
                            <th scope="col">Reachability</th>
                            <th scope="col" aria-label="Actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in _servers)
                        {
                            <tr @key="server.Id">
                                <th scope="row"><a href="/servers/@server.Id">@server.Name</a></th>
                                <td><span class="mono">@server.User@@@server.Host:@server.Port</span></td>
                                <td><span class="ui-badge neutral">@server.Group</span></td>
                                <td>
                                    <div class="tag-list">
                                        @foreach (var tag in server.Tags)
                                        {
                                            <span class="ui-badge neutral" @key="tag">@tag</span>
                                        }
                                    </div>
                                </td>
                                <td>@(server.JumpServerName ?? "—")</td>
                                @{ var sudo = server.Sudo; }
                                <td>
                                    @* Which sudo the app uses on this server (T7.R24); the detail is the tooltip and the screen-reader text. *@
                                    <span class="ui-badge @(sudo.Paused ? "warn" : "neutral") server-sudo" title="@sudo.Detail">@sudo.Label</span>
                                    <span class="visually-hidden">@sudo.Detail</span>
                                </td>
                                <td>@(server.LastSeenAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                                @{ var unreachable = Unreachable(server.Id); }
                                <td>
                                    @if (unreachable is null)
                                    {
                                        <span class="muted">Reachable</span>
                                    }
                                    else
                                    {
                                        @* A failed login says so: a bad key is not an unreachable host (T7.R19). *@
                                        <span class="ui-badge warn">@unreachable.Badge</span>
                                        <span class="server-reachability">@unreachable.Text</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (unreachable is not null || sudo.RetryAllowed)
                                        {
                                            @* Retry now bypasses the backoff for this server's whole route and tries a password whose last outcome
                                               was unknown once more (T7.R25). It never retries a rejected sudo password. *@
                                            <button class="ui-button primary compact" type="button" @onclick="() => TestConnectionAsync(server.Id)" disabled="@(_testingId == server.Id)"
                                                    aria-describedby="@(sudo.Paused && !sudo.RetryAllowed ? $"sudo-retry-blocked-{server.Id:N}" : null)">Retry now</button>
                                        }
                                        else if (sudo.Paused)
                                        {
                                            @* A rejected sudo password is not retried (D-040 amendment, pam_faillock): only an edit or removal lifts it. *@
                                            <button class="ui-button primary compact" type="button" disabled aria-describedby="sudo-retry-blocked-@server.Id.ToString("N")">Retry now</button>
                                        }
                                        <button class="ui-button secondary" type="button" @onclick="() => TestConnectionAsync(server.Id)" disabled="@(_testingId == server.Id)">Test connection</button>
                                        @* The addresses allowed to log in over SSH; the map warns about any other (T8.18). *@
                                        <button class="ui-button secondary" type="button" @onclick="() => OpenSshSources(server.Id)"
                                                aria-label="@(server.AllowedSshSources.Count > 0 ? $"SSH sources, {server.AllowedSshSources.Count} allowed" : "SSH sources")">
                                            SSH sources
                                            @if (server.AllowedSshSources.Count > 0)
                                            {
                                                <span class="ui-badge soft" aria-hidden="true">@server.AllowedSshSources.Count</span>
                                            }
                                        </button>
                                        <button class="ui-button secondary compact" type="button" @onclick="() => OpenEdit(server.Id)">Edit</button>
                                        <button class="ui-button ghost-danger compact" type="button" @onclick="() => AskDelete(server.Id)">Remove</button>
                                    </div>
                                    @if (sudo.Paused && !sudo.RetryAllowed)
                                    {
                                        <span class="server-reachability" id="sudo-retry-blocked-@server.Id.ToString("N")">@ServerSudoStatus.RetryBlockedReason</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (_formOpen)
{
    <div class="dialog-backdrop">
        <section class="ui-card inventory-dialog" role="dialog" aria-modal="true" aria-labelledby="server-dialog-title">
            <div class="servers-heading">
                <div>
                    <p class="eyebrow">Server inventory</p>
                    <h2 id="server-dialog-title">@(_editingId.HasValue ? "Edit server" : "Add server")</h2>
                </div>
                <button class="ui-button secondary compact" type="button" @onclick="CloseForm">Close</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="alert-message error" role="alert">@_formError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_unknownHostSuggestion))
            {
                <div class="topology-trace-message" role="status">
                    Adding unknown endpoint <span class="mono">@_unknownHostSuggestion</span>.
                    @if (!string.IsNullOrWhiteSpace(_suggestedJumpName))
                    {
                        <span> Suggested jump server: @_suggestedJumpName.</span>
                    }
                </div>
            }
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="inventory-form-grid">
                    <div class="field">
                        <label for="server-name">Name</label>
                        <InputText id="server-name" @bind-Value="_form.Name" autocomplete="off" />
                        <ValidationMessage For="() => _form.Name" />
                    </div>
                    <div class="field">
                        <label for="server-group">Group</label>
                        <InputSelect id="server-group" @bind-Value="_form.Group">
                            <option value="">Select a group</option>
                            @foreach (var option in ServerGroupOptions.Build(_servers.Select(server => server.Group), _form.Group))
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _form.Group" />
                    </div>
                    <div class="field">
                        <label for="server-host">Host</label>
                        <InputText id="server-host" class="mono" @bind-Value="_form.Host" placeholder="server.example.com or 10.0.0.4" autocomplete="off" />
                        <ValidationMessage For="() => _form.Host" />
                    </div>
                    <div class="field">
                        <label for="server-port">SSH port</label>
                        <InputNumber id="server-port" class="mono" @bind-Value="_form.Port" min="1" max="65535" />
                        <ValidationMessage For="() => _form.Port" />
                    </div>
                    <div class="field">
                        <label for="server-user">SSH user</label>
                        <InputText id="server-user" @bind-Value="_form.User" autocomplete="username" />
                        <ValidationMessage For="() => _form.User" />
                    </div>
                    <div class="field">
                        <label for="server-key">Private key file</label>
                        <InputSelect id="server-key" @bind-Value="_form.KeyFile">
                            <option value="">Select a file from /keys</option>
                            @foreach (var keyFile in _keyFiles)
                            {
                                <option value="@keyFile">@keyFile</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _form.KeyFile" />
                        <span class="field-helper">Keys are read from the mounted /keys directory.</span>
                    </div>
                    <div class="field">
                        <label for="server-passphrase">Key passphrase</label>
                        <InputText id="server-passphrase" type="password" @bind-Value="_form.KeyPassphrase" autocomplete="new-password" placeholder="@(_editingId.HasValue && _hasPassphrase ? "Saved · enter to replace" : "Optional")" />
                        <span class="field-helper">Encrypted at rest. Leave blank to keep the saved passphrase.</span>
                    </div>
                    <div class="field">
                        <label for="server-sudo-password">Sudo password</label>
                        @* Write-only: the value is never rendered by the server, so neither the saved password nor what was typed
                           is sent back to the browser (T7.R24). *@
                        <input id="server-sudo-password" type="password" autocomplete="new-password" spellcheck="false"
                               minlength="@ServerService.MinSudoPasswordLength" maxlength="@ServerService.MaxSudoPasswordLength"
                               aria-describedby="server-sudo-password-help"
                               placeholder="@(_editingId.HasValue && _hasSudoPassword ? "Saved · enter to replace" : "Optional")"
                               disabled="@_form.RemoveSudoPassword"
                               @onchange="args => _form.SudoPassword = args.Value as string" />
                        <span class="field-helper" id="server-sudo-password-help">Only for hosts where passwordless (NOPASSWD) sudo is not possible. At least @ServerService.MinSudoPasswordLength characters. Encrypted at rest, never shown again. Leave blank to keep the saved password.</span>
                        @if (_editingId.HasValue && _hasSudoPassword)
                        {
                            <label class="health-enabled" for="server-sudo-password-remove">
                                <InputCheckbox id="server-sudo-password-remove" @bind-Value="_form.RemoveSudoPassword" />
                                Remove the saved sudo password (use sudo -n)
                            </label>
                        }
                    </div>
                    <div class="field">
                        <label for="server-jump">Jump server</label>
                        <InputSelect id="server-jump" @bind-Value="_form.JumpServerId">
                            <option value="">None</option>
                            @foreach (var server in _servers.Where(server => server.Id != _editingId))
                            {
                                <option value="@server.Id">@server.Name · @server.Host</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="field field-span">
                        <label for="server-tags">Tags</label>
                        <InputText id="server-tags" @bind-Value="_form.TagsText" placeholder="edge, web, database" />
                        <span class="field-helper">Separate tags with commas.</span>
                    </div>
                </div>
                <div class="dialog-actions">
                    <button class="ui-button secondary" type="button" @onclick="CloseForm">Cancel</button>
                    @if (!string.IsNullOrWhiteSpace(_unknownHostSuggestion))
                    {
                        <button class="ui-button primary" type="submit" disabled="@_saving" @onclick="() => _discoverAfterSave = true">
                            @(_saving ? "Saving and discovering…" : "Save and discover this server")
                        </button>
                    }
                    else
                    {
                        <button class="ui-button primary" type="submit" disabled="@_saving" @onclick="() => _discoverAfterSave = false">@(_saving ? "Saving…" : "Save server")</button>
                    }
                </div>
            </EditForm>
        </section>
    </div>
}

@if (_sourcesServerId.HasValue)
{
    @* Esc closes it. Clicking the backdrop does not, so typed text is not lost by accident (like the other dialogs). *@
    <div class="dialog-backdrop">
        <section class="ui-card inventory-dialog ssh-sources-dialog" role="dialog" aria-modal="true" aria-labelledby="ssh-sources-title"
                 @onkeydown="OnSourcesKeyDown">
            <div class="servers-heading">
                <div>
                    <p class="eyebrow">SSH access</p>
                    <h2 id="ssh-sources-title">Allowed SSH sources · @_sourcesServerName</h2>
                </div>
                <button class="ui-button secondary compact" type="button" @onclick="CloseSshSources">Close</button>
            </div>
            <p class="muted" id="ssh-sources-help">
                DevOps Agent warns on the map when someone logs in over SSH from an address that is not listed. One IP address or
                range (CIDR) per line, for example <span class="mono">203.0.113.7</span> or <span class="mono">192.168.20.0/24</span>.
                Leave empty to turn the warning off. The agent's own connection and the jump server are always allowed.
            </p>
            <div class="field ssh-sources-field">
                <label for="ssh-sources-text">Allowed addresses</label>
                <textarea id="ssh-sources-text" class="mono" @ref="_sourcesTextArea" @bind="_sourcesText" @bind:event="oninput" rows="8"
                          spellcheck="false" autocomplete="off" autocapitalize="off" maxlength="@SshSourceList.MaxTextLength"
                          aria-describedby="ssh-sources-help@(_sourcesErrors.Count > 0 ? " ssh-sources-errors" : null)"
                          aria-invalid="@(_sourcesErrors.Count > 0 ? "true" : null)"
                          placeholder="203.0.113.7&#10;192.168.20.0/24"></textarea>
            </div>
            @if (_sourcesErrors.Count > 0)
            {
                <div class="alert-message error" role="alert" id="ssh-sources-errors">
                    <ul class="ssh-sources-errors">
                        @foreach (var error in _sourcesErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            <div class="dialog-actions">
                <button class="ui-button secondary" type="button" @onclick="CloseSshSources">Cancel</button>
                <button class="ui-button primary" type="button" @onclick="SaveSshSourcesAsync" disabled="@_sourcesSaving">@(_sourcesSaving ? "Saving…" : "Save")</button>
            </div>
        </section>
    </div>
}

@if (_deleteId.HasValue)
{
    <div class="dialog-backdrop">
        <section class="ui-card confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-server-title">
            <h2 id="delete-server-title">Remove server?</h2>
            <p class="muted">This removes the server from inventory. This action cannot be undone.</p>
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="alert-message error" role="alert">@_formError</div>
            }
            <div class="dialog-actions">
                <button class="ui-button secondary" type="button" @onclick="CancelDelete">Cancel</button>
                <button class="ui-button ghost-danger" type="button" @onclick="DeleteAsync">Remove server</button>
            </div>
        </section>
    </div>
}

@if (_importDialogOpen)
{
    <div class="dialog-backdrop">
        <section class="ui-card inventory-dialog ssh-import-dialog" role="dialog" aria-modal="true" aria-labelledby="ssh-import-title">
            <div class="servers-heading">
                <div>
                    <p class="eyebrow">Server inventory</p>
                    <h2 id="ssh-import-title">Import SSH config</h2>
                    <p class="muted">Paste OpenSSH config text. Wildcard host patterns are skipped.</p>
                </div>
                <button class="ui-button secondary compact" type="button" @onclick="CloseImport">Close</button>
            </div>
            <div class="field ssh-config-field">
                <label for="ssh-config-text">SSH config</label>
                <textarea id="ssh-config-text" class="mono" @bind="_sshConfigText" @bind:event="oninput" rows="9" spellcheck="false" placeholder="Paste an OpenSSH config snippet"></textarea>
            </div>
            <div class="field">
                <label for="ssh-import-group">Group for imported servers</label>
                <select id="ssh-import-group" @bind="_importGroup">
                    <option value="">Select a group</option>
                    <option value="prod">Production</option>
                    <option value="staging">Staging</option>
                </select>
            </div>
            @if (!string.IsNullOrWhiteSpace(_importError))
            {
                <div class="alert-message error" role="alert">@_importError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_importMessage))
            {
                <div class="settings-message success" role="status">@_importMessage</div>
            }
            @if (_importRows.Count > 0)
            {
                <p class="muted import-summary">@_importRows.Count host(s) found; @_importRows.Count(row => row.CanImport) ready to import. @_skippedWildcardCount wildcard pattern(s) skipped.</p>
                <div class="table-scroll import-preview-scroll">
                    <table class="servers-table import-preview-table">
                        <thead>
                            <tr>
                                <th scope="col">Alias</th>
                                <th scope="col">Host</th>
                                <th scope="col">Port</th>
                                <th scope="col">User</th>
                                <th scope="col">Key file</th>
                                <th scope="col">Jump server</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _importRows)
                            {
                                <tr @key="row.Entry.Alias">
                                    <th scope="row">@row.Entry.Alias</th>
                                    <td><span class="mono">@row.Entry.HostName</span></td>
                                    <td><span class="mono">@row.Entry.Port</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Entry.User) ? "—" : row.Entry.User)</td>
                                    <td><span class="mono">@(row.KeyFile ?? "—")</span></td>
                                    <td>@(row.JumpAlias ?? "—")</td>
                                    <td>@(row.Error ?? "Ready")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="dialog-actions">
                <button class="ui-button secondary" type="button" @onclick="CloseImport">Cancel</button>
                <button class="ui-button secondary" type="button" @onclick="PreviewSshConfig" disabled="@_importing">Preview</button>
                <button class="ui-button primary" type="button" @onclick="ImportSshConfigAsync" disabled="@(_importing || string.IsNullOrWhiteSpace(_importGroup) || !_importRows.Any(row => row.CanImport))">@(_importing ? "Importing…" : "Import ready servers")</button>
            </div>
        </section>
    </div>
}

@if (_testDialogOpen)
{
    <div class="dialog-backdrop">
        <section class="ui-card confirm-dialog capability-dialog" role="dialog" aria-modal="true" aria-labelledby="connection-test-title">
            <div class="servers-heading">
                <div>
                    <p class="eyebrow">SSH capability probe</p>
                    <h2 id="connection-test-title">@_testServerName</h2>
                </div>
                <button class="ui-button secondary compact" type="button" @onclick="CloseTestDialog">Close</button>
            </div>
            @if (_testingId.HasValue)
            {
                <p class="muted" role="status">Connecting and checking host capabilities…</p>
            }
            else if (_testResult is not null)
            {
                @if (!string.IsNullOrWhiteSpace(_testResult.Error))
                {
                    <div class="alert-message error" role="alert">@_testResult.Error</div>
                }
                else
                {
                    <dl class="capability-results">
                        <div><dt>Connection</dt><dd>@(_testResult.Reachable ? "Reachable" : "Unavailable")</dd></div>
                        <div><dt>Operating system</dt><dd>@(_testResult.OsInfo ?? "Not reported")</dd></div>
                        <div><dt>Uptime</dt><dd class="mono">@(_testResult.Uptime ?? "Not reported")</dd></div>
                        <div><dt>Sudo</dt><dd>@SudoTestText(_testResult)</dd></div>
                        <div><dt>Available tools</dt><dd>@(_testResult.AvailableCommands.Count > 0 ? string.Join(", ", _testResult.AvailableCommands) : "None found")</dd></div>
                    </dl>
                }
                <p class="field-helper">Checked @_testResult.TestedAtUtc.ToLocalTime().ToString("g")</p>
            }
        </section>
    </div>
}

@code {
    private IReadOnlyList<ServerSummary> _servers = [];
    private IReadOnlyList<string> _keyFiles = [];
    private ServerForm _form = new();
    private Guid? _editingId;
    private Guid? _deleteId;
    private bool _formOpen;
    private bool _saving;
    private bool _discoverAfterSave;
    private bool _hasPassphrase;
    private bool _hasSudoPassword;
    private bool _testDialogOpen;
    private Guid? _testingId;
    private string? _testServerName;
    private ServerCapabilityResult? _testResult;
    private bool _importDialogOpen;
    private bool _importing;
    private string _sshConfigText = string.Empty;
    private string? _importError;
    private string? _importMessage;
    private string _importGroup = string.Empty;
    private IReadOnlyList<SshConfigImportRow> _importRows = [];
    private int _skippedWildcardCount;
    private string? _pageError;
    private string? _formError;
    private string? _unknownHostSuggestion;
    private string? _suggestedJumpName;
    private Guid? _sourcesServerId;
    private string _sourcesServerName = string.Empty;
    private string _sourcesText = string.Empty;
    private IReadOnlyList<string> _sourcesErrors = [];
    private bool _sourcesSaving;
    private string? _sourcesMessage;
    private bool _focusSourcesText;
    private ElementReference _sourcesTextArea;

    /// <summary>A server id (N format): opens that server's allowed SSH sources dialog on load (linked from the map, T8.18).</summary>
    [SupplyParameterFromQuery(Name = "sshSources")]
    public Guid? SshSources { get; set; }

    [SupplyParameterFromQuery(Name = "unknownHost")]
    public string? UnknownHost { get; set; }

    [SupplyParameterFromQuery(Name = "suggestedJumpServerId")]
    public Guid? SuggestedJumpServerId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // A rejection, an unknown outcome or a confirmation recorded in the background shows up without a reload (T7.R26).
        StateEvents.Changed += OnServerStateChanged;
        await LoadAsync();
        if (SshSources is Guid sourcesServerId) OpenSshSources(sourcesServerId);
        if (string.IsNullOrWhiteSpace(UnknownHost)) return;

        OpenCreate();
        _unknownHostSuggestion = UnknownHost.Trim();
        _form.Host = _unknownHostSuggestion;
        _form.Name = MakeSuggestedServerName(_unknownHostSuggestion);
        if (SuggestedJumpServerId is Guid jumpId && _servers.FirstOrDefault(server => server.Id == jumpId) is { } jumpServer)
        {
            _form.JumpServerId = jumpId;
            _suggestedJumpName = jumpServer.Name;
        }
    }

    private async Task LoadAsync()
    {
        _servers = await ServersService.ListAsync(CancellationToken.None);
        _keyFiles = ServersService.ListKeyFiles();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusSourcesText) return;
        _focusSourcesText = false;
        try
        {
            await _sourcesTextArea.FocusAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSDisconnectedException)
        {
            // The dialog closed again, or the circuit went away, before the focus call ran.
        }
    }

    private void OpenSshSources(Guid id)
    {
        var server = _servers.FirstOrDefault(item => item.Id == id);
        if (server is null) return;

        _sourcesServerId = id;
        _sourcesServerName = server.Name;
        _sourcesText = SshSourceList.Format(server.AllowedSshSources);
        _sourcesErrors = [];
        _sourcesMessage = null;
        _focusSourcesText = true;
    }

    private void CloseSshSources()
    {
        _sourcesServerId = null;
        _sourcesErrors = [];
    }

    private void OnSourcesKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseSshSources();
    }

    private async Task SaveSshSourcesAsync()
    {
        if (_sourcesServerId is not Guid id || _sourcesSaving) return;

        _sourcesSaving = true;
        try
        {
            var result = await ServersService.SetAllowedSshSourcesAsync(id, _sourcesText, CancellationToken.None);
            if (result.ServerNotFound)
            {
                _sourcesServerId = null;
                _pageError = "That server no longer exists.";
                await LoadAsync();
                return;
            }

            if (!result.Saved)
            {
                _sourcesErrors = result.Errors;
                _focusSourcesText = true;
                return;
            }

            _sourcesServerId = null;
            _sourcesErrors = [];
            _pageError = null;
            _sourcesMessage = result.Sources.Count == 0
                ? $"Allowed SSH sources cleared for {_sourcesServerName}. The SSH source warning is off for this server."
                : $"Saved {result.Sources.Count} allowed SSH {(result.Sources.Count == 1 ? "source" : "sources")} for {_sourcesServerName}.";
            await LoadAsync();
        }
        finally
        {
            _sourcesSaving = false;
        }
    }

    private void OnServerStateChanged(Guid serverId) => _ = InvokeAsync(async () =>
    {
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception) when (_disposed) { } // the page was closed while it reloaded
    });

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        StateEvents.Changed -= OnServerStateChanged;
    }

    private void OpenCreate()
    {
        _editingId = null;
        _hasPassphrase = false;
        _hasSudoPassword = false;
        _formError = null;
        _form = new ServerForm();
        _discoverAfterSave = false;
        _unknownHostSuggestion = null;
        _suggestedJumpName = null;
        _formOpen = true;
    }

    private static string MakeSuggestedServerName(string host)
    {
        var name = System.Text.RegularExpressions.Regex.Replace(host.Trim(), "[^a-zA-Z0-9_-]+", "-").Trim('-');
        return name.Length == 0 ? "unknown-server" : name[..Math.Min(name.Length, 120)];
    }

    private void OpenEdit(Guid id)
    {
        var server = _servers.Single(item => item.Id == id);
        _editingId = id;
        _hasPassphrase = server.HasKeyPassphrase;
        _hasSudoPassword = server.HasSudoPassword;
        _formError = null;
        _form = new ServerForm
        {
            Name = server.Name,
            Host = server.Host,
            Port = server.Port,
            User = server.User,
            KeyFile = server.KeyFile,
            JumpServerId = server.JumpServerId,
            Group = ServerGroupOptions.Normalize(server.Group),
            TagsText = string.Join(", ", server.Tags)
        };
        _formOpen = true;
    }

    private void CloseForm() => _formOpen = false;

    private ServerReachabilityStatus? Unreachable(Guid serverId) => ServerReachability.Status(serverId,
        _servers.ToDictionary(server => server.Id, server => (server.Name, server.JumpServerId)), Reachability);

    private async Task TestConnectionAsync(Guid id)
    {
        _testDialogOpen = true;
        _testingId = id;
        _testResult = null;
        _testServerName = _servers.FirstOrDefault(server => server.Id == id)?.Name ?? "Server connection test";
        try
        {
            _testResult = await CapabilityService.TestAsync(id, CancellationToken.None);
            await LoadAsync();
        }
        catch (Exception)
        {
            _testResult = new ServerCapabilityResult(id, false, null, null, null, [],
                "Connection test failed unexpectedly. Review the server and SSH configuration.", DateTimeOffset.UtcNow);
        }
        finally
        {
            _testingId = null;
        }
    }

    private void CloseTestDialog() => _testDialogOpen = false;

    private static string SudoTestText(ServerCapabilityResult result) => result switch
    {
        { SudoProbeSkipped: true } => "Not tried: the saved password was rejected earlier. " + ServerSudoStatus.RetryBlockedReason,
        { SudoPasswordRejected: true } => "Password rejected — sudo paused until the password is edited or removed",
        { SudoPasswordOutcomeUnknown: true } => "Outcome unknown — sudo did not confirm the password in time; password sudo paused until Retry now or an edit",
        { SudoCapable: true, SudoPasswordUsed: true } => "Available (password)",
        { SudoCapable: true } => "Available (NOPASSWD)",
        { SudoPasswordUsed: true } => "Unavailable (sudo with the saved password failed, but not because of a wrong password)",
        _ => "Unavailable"
    };

    private void OpenImport()
    {
        _sshConfigText = string.Empty;
        _importRows = [];
        _importError = null;
        _importMessage = null;
        _importGroup = string.Empty;
        _skippedWildcardCount = 0;
        _importDialogOpen = true;
    }

    private void CloseImport() => _importDialogOpen = false;

    private void PreviewSshConfig()
    {
        _importError = null;
        try
        {
            var parsed = SshConfigParser.Parse(_sshConfigText);
            _skippedWildcardCount = parsed.SkippedWildcardHostCount;
            var aliases = parsed.Entries.ToDictionary(entry => entry.Alias, StringComparer.OrdinalIgnoreCase);
            var keyFiles = ServersService.ListKeyFiles();
            _importRows = parsed.Entries.Select(entry =>
            {
                var identityName = Path.GetFileName(entry.IdentityFile.Replace('\\', '/'));
                var keyFile = keyFiles.FirstOrDefault(name => string.Equals(name, identityName, StringComparison.Ordinal));
                var jumpAlias = GetProxyJumpAlias(entry.ProxyJump);
                var existingJump = jumpAlias is null ? null : _servers.FirstOrDefault(server =>
                    string.Equals(server.Name, jumpAlias, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(server.Host, jumpAlias, StringComparison.OrdinalIgnoreCase));
                var problem = string.IsNullOrWhiteSpace(entry.User) ? "SSH user is missing."
                    : string.IsNullOrWhiteSpace(entry.IdentityFile) ? "IdentityFile is missing."
                    : keyFile is null ? "IdentityFile does not match a file in /keys."
                    : _servers.Any(server => string.Equals(server.Name, entry.Alias, StringComparison.OrdinalIgnoreCase)) ? "A server with this alias already exists."
                    : entry.ProxyJump?.Contains(',') == true ? "Use a single ProxyJump alias and define its route in that host's stanza."
                    : jumpAlias is not null && existingJump is null && !aliases.ContainsKey(jumpAlias) ? $"ProxyJump host '{jumpAlias}' was not found."
                    : null;
                return new SshConfigImportRow(entry, keyFile, jumpAlias, existingJump?.Id, problem);
            }).ToArray();

            if (_importRows.Count == 0)
            {
                _importError = "No exact Host entries were found. Wildcard host patterns are skipped.";
            }
        }
        catch (FormatException exception)
        {
            _importRows = [];
            _importError = exception.Message;
        }
        catch (ArgumentException exception)
        {
            _importRows = [];
            _importError = $"Unable to parse SSH config: {exception.Message}";
        }
    }

    private async Task ImportSshConfigAsync()
    {
        _importError = null;
        _importMessage = null;
        if (string.IsNullOrWhiteSpace(_importGroup))
        {
            _importError = "Choose the group for the imported servers.";
            return;
        }

        _importing = true;
        try
        {
            var remaining = _importRows.Where(row => row.CanImport).ToList();
            var importedByAlias = new Dictionary<string, Guid>(StringComparer.OrdinalIgnoreCase);
            var scheduledAliases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var ordered = new List<SshConfigImportRow>();
            while (remaining.Count > 0)
            {
                var ready = remaining.Where(row => row.JumpAlias is null
                    || row.ExistingJumpServerId.HasValue
                    || scheduledAliases.Contains(row.JumpAlias)).ToArray();
                if (ready.Length == 0)
                {
                    _importError = "The selected hosts contain a ProxyJump cycle or depend on a host that cannot be imported.";
                    return;
                }

                foreach (var row in ready)
                {
                    remaining.Remove(row);
                    ordered.Add(row);
                    scheduledAliases.Add(row.Entry.Alias);
                }
            }

            var importedCount = 0;
            foreach (var row in ordered)
            {
                Guid? jumpServerId = row.ExistingJumpServerId;
                if (row.JumpAlias is not null)
                {
                    if (row.ExistingJumpServerId is Guid existingId)
                    {
                        jumpServerId = existingId;
                    }
                    else if (importedByAlias.TryGetValue(row.JumpAlias, out var importedId))
                    {
                        jumpServerId = importedId;
                    }
                    else
                    {
                        var importedJump = _servers.FirstOrDefault(server =>
                            string.Equals(server.Name, row.JumpAlias, StringComparison.OrdinalIgnoreCase)
                            || string.Equals(server.Host, row.JumpAlias, StringComparison.OrdinalIgnoreCase));
                        jumpServerId = importedJump?.Id;
                    }

                    if (!jumpServerId.HasValue)
                    {
                        row.Error = $"ProxyJump host '{row.JumpAlias}' has not been imported.";
                        continue;
                    }
                }

                try
                {
                    var created = await ServersService.CreateAsync(new ServerInput(
                        row.Entry.Alias, row.Entry.HostName, row.Entry.Port, row.Entry.User, row.KeyFile!, null,
                        jumpServerId, _importGroup, []), CancellationToken.None);
                    importedByAlias[row.Entry.Alias] = created.Id;
                    importedCount++;
                }
                catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
                {
                    row.Error = exception.Message;
                }
            }

            await LoadAsync();
            if (importedCount > 0)
            {
                _importMessage = $"Imported {importedCount} server(s). Review any rows marked with an error before importing them separately.";
                _importRows = _importRows.Where(row => row.Error is not null).ToArray();
                if (_importRows.Count == 0)
                {
                    _importDialogOpen = false;
                }
            }
        }
        finally
        {
            _importing = false;
        }
    }

    private static string? GetProxyJumpAlias(string? proxyJump)
    {
        if (string.IsNullOrWhiteSpace(proxyJump) || string.Equals(proxyJump, "none", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var jump = proxyJump.Trim();
        var at = jump.LastIndexOf('@');
        if (at >= 0)
        {
            jump = jump[(at + 1)..];
        }

        if (jump.StartsWith('[') && jump.IndexOf(']') is var closeBracket && closeBracket > 0)
        {
            return jump[1..closeBracket];
        }

        var colon = jump.LastIndexOf(':');
        return colon > 0 && jump.IndexOf(':') == colon ? jump[..colon] : jump;
    }

    private async Task SaveAsync()
    {
        var discoverServer = _discoverAfterSave && !string.IsNullOrWhiteSpace(_unknownHostSuggestion);
        _saving = true;
        _formError = null;
        try
        {
            var input = new ServerInput(
                _form.Name, _form.Host, _form.Port, _form.User, _form.KeyFile, _form.KeyPassphrase, _form.JumpServerId,
                _form.Group, _form.TagsText.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
                _form.RemoveSudoPassword ? null : _form.SudoPassword, _form.RemoveSudoPassword);
            if (_editingId is Guid id)
            {
                _ = await ServersService.UpdateAsync(id, input, CancellationToken.None);
                _form.SudoPassword = null;
            }
            else
            {
                var created = await ServersService.CreateAsync(input, CancellationToken.None);
                _form.SudoPassword = null;
                _formOpen = false;
                await LoadAsync();
                if (discoverServer)
                {
                    try
                    {
                        _ = await Discovery.RunServerAndMergeAsync(created.Id, null, CancellationToken.None);
                        Navigation.NavigateTo("/topology");
                        return;
                    }
                    catch (Exception)
                    {
                        _pageError = "The server was added, but its discovery could not complete. Check its SSH access, then run discovery again from Topology.";
                    }
                }

                _discoverAfterSave = false;
                return;
            }

            _formOpen = false;
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            // The validation sentence only, without .NET's " (Parameter 'input')" suffix.
            _formError = exception.ParamName is { } name
                ? exception.Message.Replace($" (Parameter '{name}')", string.Empty, StringComparison.Ordinal)
                : exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(Guid id)
    {
        _formError = null;
        _deleteId = id;
    }

    private void CancelDelete() => _deleteId = null;

    private async Task DeleteAsync()
    {
        if (_deleteId is not Guid id) return;
        try
        {
            _ = await ServersService.DeleteAsync(id, CancellationToken.None);
            _deleteId = null;
            _pageError = null;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _formError = exception.Message;
        }
    }

    private sealed class ServerForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(120)]
        public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string Host { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Range(1, 65535)]
        public int Port { get; set; } = 22;
        [System.ComponentModel.DataAnnotations.Required]
        public string User { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Select a private key file.")]
        public string KeyFile { get; set; } = string.Empty;
        public string? KeyPassphrase { get; set; }
        public string? SudoPassword { get; set; }
        public bool RemoveSudoPassword { get; set; }
        public Guid? JumpServerId { get; set; }
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Choose a group.")]
        public string Group { get; set; } = string.Empty;
        public string TagsText { get; set; } = string.Empty;
    }

    private sealed class SshConfigImportRow(
        SshConfigEntry entry,
        string? keyFile,
        string? jumpAlias,
        Guid? existingJumpServerId,
        string? error)
    {
        public SshConfigEntry Entry { get; } = entry;
        public string? KeyFile { get; } = keyFile;
        public string? JumpAlias { get; } = jumpAlias;
        public Guid? ExistingJumpServerId { get; } = existingJumpServerId;
        public string? Error { get; set; } = error;
        public bool CanImport => string.IsNullOrWhiteSpace(Error);
    }
}
