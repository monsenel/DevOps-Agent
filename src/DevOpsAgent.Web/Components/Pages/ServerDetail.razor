@page "/servers/{ServerId:guid}"
@inject ServerService Servers
@inject MetricService Metrics
@inject HealthCheckService HealthChecks
@inject NavigationManager Navigation
@inject IHostKeyStore HostKeys
@inject ISshConnectionPool ConnectionPool
@inject ServerCapabilityService Capabilities

<PageTitle>@(_server?.Name ?? "Server") · DevOps Agent</PageTitle>

<div class="page-stack">
    @if (_missing)
    {
        <section class="ui-card">
            <EmptyState Title="Server not found" Description="This server is no longer in the inventory." ActionLabel="Back to servers" OnAction="BackToServers" />
        </section>
    }
    else if (_server is not null)
    {
        <section class="ui-card server-detail-heading">
            <div>
                <p class="eyebrow">Server detail · @_server.Group</p>
                <h2>@_server.Name</h2>
                <p class="muted mono">@_server.User@@@_server.Host:@_server.Port · @(_server.OsInfo ?? "OS not detected")</p>
            </div>
            <a class="ui-button secondary" href="/servers">Back to servers</a>
        </section>

        @* T8.4 (D-041): the stored host key, recorded on first use or added by hand, and a refused changed key. *@
        <section class="ui-card host-key-card" aria-labelledby="host-key-title">
            <div class="ui-card-header">
                <div>
                    <h2 id="host-key-title">SSH host key</h2>
                    <p class="muted">Recorded automatically on the first successful connection; keys in your own known_hosts are always honoured.</p>
                </div>
            </div>
            @if (_hostKeyMessage is not null)
            {
                <div class="settings-message @(_hostKeyError ? "error" : "success")" role="status">@_hostKeyMessage</div>
            }
            @if (_hostKeys.Count == 0)
            {
                <p class="muted">No key stored yet. It is recorded on the next successful connection.</p>
            }
            else
            {
                <dl class="host-key-list">
                    @foreach (var key in _hostKeys)
                    {
                        <div class="host-key-row" @key="key.Fingerprint">
                            <dt><span class="mono">@key.KeyType</span></dt>
                            <dd>
                                <span class="mono host-key-fingerprint">@key.Fingerprint</span>
                                <span class="muted">@(key.Manual ? "From your known_hosts (added manually)" : key.FirstSeenUtc is { } seen ? $"First seen {seen.ToLocalTime():g}" : "Recorded by the app")</span>
                            </dd>
                        </div>
                    }
                </dl>
            }
            @if (_mismatch is not null)
            {
                <div class="host-key-mismatch" role="alert">
                    <p><strong>Host key changed.</strong> On @_mismatch.SeenAtUtc.ToLocalTime().ToString("g") the server presented a different key, and every connection is refused until you decide. This can mean a reinstalled server or someone impersonating it.</p>
                    <p class="mono">Presented: @_mismatch.PresentedKeyType @_mismatch.PresentedFingerprint</p>
                    @if (_mismatch.StoredIsManual)
                    {
                        <p class="muted">The stored key comes from your own known_hosts file. Verify the new key, then update that file.</p>
                    }
                    else
                    {
                        <button class="ui-button secondary" type="button" @onclick="() => _acceptOpen = true">Accept new key</button>
                    }
                </div>
            }
        </section>

        <section class="server-metric-grid" aria-label="Latest server metrics">
            <StatTile Label="CPU" Value="@Format("cpu_percent")" Suffix="%" IconName="server" />
            <StatTile Label="Memory" Value="@Format("memory_percent")" Suffix="%" IconName="server" />
            <StatTile Label="Disk · /" Value="@Format("disk_percent")" Suffix="%" IconName="server" />
            <StatTile Label="Load · 1 min" Value="@Format("load_1m")" IconName="activity" />
        </section>

        <section class="ui-card health-check-card" aria-labelledby="health-check-title">
            <div class="ui-card-header health-check-heading">
                <div>
                    <h2 id="health-check-title">Health checks</h2>
                    <p class="muted">Scheduled HTTP, HTTPS, and TCP checks for this server.</p>
                </div>
                <div class="health-check-actions">
                    <button class="ui-button secondary" type="button" @onclick="SuggestChecksAsync">Suggest from discovery</button>
                    <button class="ui-button primary" type="button" @onclick="OpenNewHealthCheck">Add check</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_healthError))
            {
                <div class="alert-message error" role="alert">@_healthError</div>
            }
            @if (_healthChecks.Count == 0)
            {
                <EmptyState Title="No health checks yet" Description="Add a URL or port check, or suggest checks from the latest discovery." />
            }
            else
            {
                <div class="table-scroll">
                    <table class="servers-table health-check-table">
                        <thead><tr><th scope="col">Check</th><th scope="col">Target</th><th scope="col">Interval</th><th scope="col">Status</th><th scope="col">TLS expiry</th><th scope="col">Last checked</th><th scope="col" aria-label="Actions"></th></tr></thead>
                        <tbody>
                            @foreach (var check in _healthChecks)
                            {
                                <tr @key="check.Id">
                                    <th scope="row">@check.Name <span class="ui-badge neutral">@check.Type</span></th>
                                    <td class="mono">@check.Target</td>
                                    <td class="mono">@check.IntervalSeconds s</td>
                                    <td><span class="ui-badge @(check.Status == HealthCheckStatus.Healthy ? "soft" : check.Status == HealthCheckStatus.Unhealthy ? "danger" : "neutral")">@check.Status@(check.StatusCode is int code ? $" · {code}" : string.Empty)</span></td>
                                    <td>@(check.TlsDaysRemaining is int days ? $"{days} days" : check.Type == HealthCheckType.Https ? "Pending" : "—")</td>
                                    <td class="mono">@(check.CheckedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td>
                                    <td><div class="table-actions"><button class="ui-button secondary compact" type="button" @onclick="() => EditHealthCheck(check)">Edit</button><button class="ui-button ghost-danger compact" type="button" @onclick="() => _deleteHealthCheckId = check.Id">Remove</button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_suggestions.Count > 0)
            {
                <div class="health-suggestions">
                    <h3>Suggested from latest discovery</h3>
                    @foreach (var suggestion in _suggestions)
                    {
                        <div class="health-suggestion" @key="suggestion.Target">
                            <div><strong>@suggestion.Name</strong><span class="mono muted">@suggestion.Target</span></div>
                            <button class="ui-button secondary compact" type="button" @onclick="() => AddSuggestionAsync(suggestion)">Add check</button>
                        </div>
                    }
                </div>
            }
            @if (_healthFormOpen)
            {
                <EditForm Model="_healthForm" OnValidSubmit="SaveHealthCheckAsync">
                    <div class="health-form">
                        <div class="field"><label for="health-name">Name</label><InputText id="health-name" @bind-Value="_healthForm.Name" /></div>
                        <div class="field"><label for="health-type">Type</label><InputSelect id="health-type" @bind-Value="_healthForm.Type"><option value="Http">HTTP</option><option value="Https">HTTPS</option><option value="Tcp">TCP</option></InputSelect></div>
                        <div class="field health-target-field"><label for="health-target">Target</label><InputText id="health-target" class="mono" @bind-Value="_healthForm.Target" placeholder="https://example.com/ or host:443" /></div>
                        <div class="field"><label for="health-interval">Interval · seconds</label><InputNumber id="health-interval" @bind-Value="_healthForm.IntervalSeconds" min="15" max="86400" /></div>
                        <label class="health-enabled"><InputCheckbox @bind-Value="_healthForm.IsEnabled" /> Enabled</label>
                        <div class="health-form-actions"><button class="ui-button secondary" type="button" @onclick="CloseHealthForm">Cancel</button><button class="ui-button primary" type="submit" disabled="@_healthSaving">@(_healthSaving ? "Saving…" : "Save check")</button></div>
                    </div>
                </EditForm>
            }
        </section>

        <section class="ui-card server-metric-history" aria-labelledby="metric-history-title">
            <div class="ui-card-header">
                <div>
                    <h2 id="metric-history-title">Recent metrics</h2>
                    <p class="muted">Raw samples from the last 24 hours. Polling runs every 60 seconds.</p>
                </div>
                <span class="mono muted">@(_metrics?.Latest.MaxBy(item => item.AtUtc)?.AtUtc.ToLocalTime().ToString("g") ?? "No samples yet")</span>
            </div>
            @if (_metrics is null || _metrics.Recent.Count == 0)
            {
                <EmptyState Title="No metric samples yet" Description="The poller will show CPU, memory, disk, load, and network data after its next successful SSH check." />
            }
            else
            {
                <div class="table-scroll">
                    <table class="servers-table metric-table">
                        <thead><tr><th scope="col">Metric</th><th scope="col">Value</th><th scope="col">Sampled</th></tr></thead>
                        <tbody>
                            @foreach (var sample in _metrics.Recent.OrderByDescending(item => item.AtUtc).Take(100))
                            {
                                <tr @key="(sample.Name, sample.AtUtc)">
                                    <th scope="row">@Label(sample.Name)</th>
                                    <td class="mono">@FormatValue(sample.Name, sample.Value)</td>
                                    <td class="mono">@sample.AtUtc.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@if (_deleteHealthCheckId.HasValue)
{
    <div class="dialog-backdrop">
        <section class="ui-card confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-health-check-title">
            <h2 id="delete-health-check-title">Remove health check?</h2>
            <p class="muted">This removes the scheduled check and its latest status.</p>
            <div class="dialog-actions">
                <button class="ui-button secondary" type="button" @onclick="() => _deleteHealthCheckId = null">Cancel</button>
                <button class="ui-button ghost-danger" type="button" @onclick="DeleteHealthCheckAsync">Remove check</button>
            </div>
        </section>
    </div>
}

@if (_acceptOpen && _mismatch is not null)
{
    <div class="dialog-backdrop">
        <section class="ui-card confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="accept-key-title">
            <h2 id="accept-key-title">Accept the new host key?</h2>
            <p class="muted">Compare the new fingerprint with the key on the server itself (for example <span class="mono">ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub</span>, run on its console), not through this connection.</p>
            <dl class="host-key-compare">
                @foreach (var old in _mismatch.Stored)
                {
                    <dt>Stored (old)</dt><dd class="mono">@old.KeyType @old.Fingerprint</dd>
                }
                <dt>Presented (new)</dt><dd class="mono">@_mismatch.PresentedKeyType @_mismatch.PresentedFingerprint</dd>
            </dl>
            <label class="health-enabled" for="accept-key-confirm">
                <input id="accept-key-confirm" type="checkbox" checked="@_acceptConfirmed" @onchange="args => _acceptConfirmed = args.Value is true" />
                I compared the new fingerprint on the server and it matches.
            </label>
            <div class="dialog-actions">
                <button class="ui-button secondary" type="button" @onclick="CloseAccept">Cancel</button>
                <button class="ui-button primary" type="button" disabled="@(!_acceptConfirmed || _accepting)" @onclick="AcceptKeyAsync">@(_accepting ? "Replacing…" : "Replace stored key")</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid ServerId { get; set; }

    private IReadOnlyList<HostKeyInfo> _hostKeys = [];
    private HostKeyMismatch? _mismatch;
    private bool _acceptOpen;
    private bool _acceptConfirmed;
    private bool _accepting;
    private string? _hostKeyMessage;
    private bool _hostKeyError;

    private void LoadHostKeys()
    {
        if (_server is null) return;
        _hostKeys = HostKeys.GetKeys(_server.Host, _server.Port);
        _mismatch = HostKeys.GetMismatch(_server.Host, _server.Port);
    }

    private void CloseAccept()
    {
        _acceptOpen = false;
        _acceptConfirmed = false;
    }

    private async Task AcceptKeyAsync()
    {
        if (_server is null || _mismatch is null || !_acceptConfirmed) return;
        _accepting = true;
        try
        {
            await HostKeys.AcceptPresentedKeyAsync(_server.Host, _server.Port, _mismatch.PresentedFingerprint, CancellationToken.None);
            // Reconnect now with the accepted key (this is also "Retry now" for a host in backoff).
            ConnectionPool.Evict(_server.Id);
            var test = await Capabilities.TestAsync(_server.Id, CancellationToken.None);
            _hostKeyError = !test.Reachable;
            _hostKeyMessage = test.Reachable ? "New key stored; the connection works again." : $"New key stored, but the connection test failed: {test.Error}";
        }
        catch (InvalidOperationException exception)
        {
            _hostKeyError = true;
            _hostKeyMessage = exception.Message;
        }
        finally
        {
            _accepting = false;
            CloseAccept();
            LoadHostKeys();
        }
    }

    private ServerSummary? _server;
    private ServerMetrics? _metrics;
    private IReadOnlyList<HealthCheckDto> _healthChecks = [];
    private IReadOnlyList<HealthCheckSuggestion> _suggestions = [];
    private HealthCheckForm _healthForm = new();
    private bool _healthFormOpen;
    private bool _healthSaving;
    private Guid? _editingHealthCheckId;
    private Guid? _deleteHealthCheckId;
    private string? _healthError;
    private bool _missing;

    protected override async Task OnParametersSetAsync()
    {
        _server = (await Servers.ListAsync(CancellationToken.None)).SingleOrDefault(item => item.Id == ServerId);
        _missing = _server is null;
        _metrics = _server is null ? null : await Metrics.GetServerMetricsAsync(ServerId, CancellationToken.None);
        _healthChecks = _server is null ? [] : await HealthChecks.ListAsync(ServerId, CancellationToken.None);
        LoadHostKeys();
    }

    private string Format(string name)
    {
        var value = _metrics?.Latest.FirstOrDefault(item => item.Name == name)?.Value;
        return value.HasValue ? value.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) : "—";
    }

    private void BackToServers() => Navigation.NavigateTo("/servers");

    private void OpenNewHealthCheck()
    {
        _editingHealthCheckId = null;
        _healthForm = new HealthCheckForm { Name = $"HTTP · {_server?.Name}", Target = $"http://{_server?.Host}/" };
        _healthError = null;
        _healthFormOpen = true;
    }

    private void EditHealthCheck(HealthCheckDto check)
    {
        _editingHealthCheckId = check.Id;
        _healthForm = new HealthCheckForm
        {
            Name = check.Name, Type = check.Type, Target = check.Target, IntervalSeconds = check.IntervalSeconds,
            IsEnabled = check.IsEnabled
        };
        _healthError = null;
        _healthFormOpen = true;
    }

    private void CloseHealthForm() => _healthFormOpen = false;

    private async Task SaveHealthCheckAsync()
    {
        _healthSaving = true;
        _healthError = null;
        try
        {
            var input = new HealthCheckInput(_healthForm.Name, _healthForm.Type, _healthForm.Target,
                _healthForm.IntervalSeconds, _healthForm.IsEnabled);
            if (_editingHealthCheckId is Guid id)
                _ = await HealthChecks.UpdateAsync(id, input, CancellationToken.None);
            else
                _ = await HealthChecks.CreateAsync(ServerId, input, CancellationToken.None);
            await LoadHealthChecksAsync();
            _healthFormOpen = false;
        }
        catch (ArgumentException exception) { _healthError = exception.Message; }
        finally { _healthSaving = false; }
    }

    private async Task SuggestChecksAsync()
    {
        _healthError = null;
        _suggestions = await HealthChecks.SuggestAsync(ServerId, CancellationToken.None);
        if (_suggestions.Count == 0) _healthError = "No HTTPS domains or listening TCP ports were found in the latest discovery.";
    }

    private async Task AddSuggestionAsync(HealthCheckSuggestion suggestion)
    {
        try
        {
            _ = await HealthChecks.CreateAsync(ServerId,
                new HealthCheckInput(suggestion.Name, suggestion.Type, suggestion.Target, suggestion.IntervalSeconds),
                CancellationToken.None);
            _suggestions = _suggestions.Where(item => item.Target != suggestion.Target).ToArray();
            await LoadHealthChecksAsync();
        }
        catch (ArgumentException exception) { _healthError = exception.Message; }
    }

    private async Task LoadHealthChecksAsync() =>
        _healthChecks = await HealthChecks.ListAsync(ServerId, CancellationToken.None);

    private async Task DeleteHealthCheckAsync()
    {
        if (_deleteHealthCheckId is Guid id) _ = await HealthChecks.DeleteAsync(id, CancellationToken.None);
        _deleteHealthCheckId = null;
        await LoadHealthChecksAsync();
    }

    private static string Label(string name) => name switch
    {
        "cpu_percent" => "CPU",
        "memory_percent" => "Memory",
        "memory_used_bytes" => "Memory used",
        "memory_total_bytes" => "Memory total",
        "disk_percent" => "Disk · /",
        "disk_used_bytes" => "Disk used · /",
        "disk_total_bytes" => "Disk total · /",
        "load_1m" => "Load · 1 min",
        "load_5m" => "Load · 5 min",
        "load_15m" => "Load · 15 min",
        "network_receive_bytes_per_second" => "Network received",
        "network_transmit_bytes_per_second" => "Network sent",
        _ => name
    };

    private static string FormatValue(string name, double value) => name switch
    {
        "cpu_percent" or "memory_percent" or "disk_percent" => $"{value:0.0}%",
        "memory_used_bytes" or "memory_total_bytes" or "disk_used_bytes" or "disk_total_bytes" => $"{value / 1024d / 1024d:0.0} MiB",
        "network_receive_bytes_per_second" or "network_transmit_bytes_per_second" => $"{value / 1024d / 1024d:0.00} MiB/s",
        _ => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
    };

    private sealed class HealthCheckForm
    {
        public string Name { get; set; } = string.Empty;
        public HealthCheckType Type { get; set; } = HealthCheckType.Http;
        public string Target { get; set; } = string.Empty;
        public int IntervalSeconds { get; set; } = 60;
        public bool IsEnabled { get; set; } = true;
    }
}
