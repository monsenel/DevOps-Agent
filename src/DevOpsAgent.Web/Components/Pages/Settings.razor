    private void UpdateDigestHour(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var hour))
        {
            _digestUtcHour = hour;
        }
    }

    private async Task SaveDailyDigestAsync()
    {
        _savingDigest = true;
        _digestMessage = null;
        _digestError = null;
        try
        {
            var saved = await DailyDigest.SaveSettingsAsync(_digestEnabled, _digestUtcHour, CancellationToken.None);
            _digestEnabled = saved.Enabled;
            _digestUtcHour = saved.UtcHour;
            _digestLastSentAtUtc = saved.LastSentAtUtc;
            _digestMessage = saved.Enabled
                ? $"Daily digest enabled for {saved.UtcHour:00}:00 UTC."
                : "Daily digest disabled.";
        }
        catch (ArgumentOutOfRangeException exception)
        {
            _digestError = exception.Message.Split(" (Parameter")[0];
        }
        finally
        {
            _savingDigest = false;
        }
    }

    private async Task SendDailyDigestNowAsync()
    {
        _sendingDigest = true;
        _digestMessage = null;
        _digestError = null;
        try
        {
            var result = await DailyDigest.SendNowAsync(CancellationToken.None);
            if (result.Sent)
            {
                _digestLastSentAtUtc = result.Summary.GeneratedAtUtc;
                _digestMessage = $"Daily digest sent to {result.DeliveredEndpoints} destination(s).";
            }
            else
            {
                _digestError = result.SkippedReason ?? "Daily digest could not be sent.";
            }
        }
        catch (Exception exception)
        {
            _digestError = exception.Message;
        }
        finally
        {
            _sendingDigest = false;
        }
    }

    private void UpdateExecutionModeForGroup(ExecutionModePolicy policy, ChangeEventArgs args)
    {
        if (Enum.TryParse<ExecutionMode>(args.Value?.ToString(), out var mode) && Enum.IsDefined(mode))
        {
            ReplaceExecutionPolicy(policy with { Mode = mode });
        }
    }

    private void ReplaceExecutionPolicy(ExecutionModePolicy updated)
    {
        var index = _executionPolicies.FindIndex(policy => policy.Group == updated.Group);
        if (index >= 0) _executionPolicies[index] = updated;
        _executionMessage = null;
        _executionError = null;
    }

    private async Task LoadExecutionPoliciesAsync()
    {
        _executionPolicies.Clear();
        _executionPolicies.AddRange(await ExecutionModes.ListAsync(CancellationToken.None));
        _executionUnreadable = await ExecutionModes.IsStoredSettingUnreadableAsync(CancellationToken.None);
    }

    private async Task SaveExecutionPolicyAsync(ExecutionModePolicy policy)
    {
        _savingExecutionGroup = true;
        _executionMessage = null;
        _executionError = null;
        try
        {
            await ExecutionModes.SaveAsync(policy, CancellationToken.None);
            // Show what is actually stored now (other groups may have been pinned to read-only).
            await LoadExecutionPoliciesAsync();
            _executionMessage = $"Policy saved for {policy.Group}.";
        }
        catch (ArgumentException exception)
        {
            _executionError = exception.Message;
        }
        finally
        {
            _savingExecutionGroup = false;
        }
    }

