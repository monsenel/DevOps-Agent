    private async Task RefreshModelsAsync()
    {
        _isRefreshing = true;
        _error = null;
        _message = null;
        try
        {
            var models = await Providers.RefreshModelsAsync(_editor.SelectedId, _editor.Form.BaseUrl, _editor.Form.ApiKey,
                _editor.Form.TimeoutSeconds, CancellationToken.None);
            _modelOptions.Clear();
            _modelOptions.AddRange(models);
            if (_modelOptions.Count > 0 && !_modelOptions.Contains(_editor.Form.Model, StringComparer.Ordinal))
            {
                _editor.Form.Model = _modelOptions[0];
            }
            _message = $"Found {_modelOptions.Count} model{(_modelOptions.Count == 1 ? string.Empty : "s")}.";
        }
        catch (Exception)
        {
            _error = "Could not list models. Check the endpoint and API key.";
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task SaveAsync() => await PersistAsync();

    private async Task<LlmProviderSummary?> PersistAsync()
    {
        _isSaving = true;
        _error = null;
        _message = null;
        try
        {
            if (_editor.Form.Type is not { } type)
            {
                _error = "Choose a provider type.";
                return null;
            }

            var hadStoredKey = _hasSavedApiKey && string.IsNullOrWhiteSpace(_editor.Form.ApiKey);
            var input = new LlmProviderInput(_editor.Form.Name, type, _editor.Form.BaseUrl, _editor.Form.Model,
                _editor.Form.ContextWindow, _editor.Form.Temperature, _editor.Form.TimeoutSeconds, _editor.Form.IsDefault,
                _editor.Form.NativeToolCallingEnabled, _editor.Form.StreamingEnabled, _editor.Form.RedactSecretsBeforeSending, _editor.Form.ApiKey);
            var saved = _editor.SelectedId is { } id
                ? await Providers.UpdateAsync(id, input, CancellationToken.None)
                : await Providers.CreateAsync(input, CancellationToken.None);
            if (saved is null)
            {
                _error = "This provider no longer exists. Refresh and try again.";
                return null;
            }

            await LoadProvidersAsync(saved.Id);
            _message = hadStoredKey && !saved.HasApiKey
                ? "Provider saved. The stored API key was removed because the base URL changed; enter the key again."
                : "Provider saved.";
            return saved;
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
            return null;
        }
        catch (Exception)
        {
            _error = "Could not save provider. Check the values and try again.";
            return null;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        var saved = await PersistAsync();
        if (saved is null) return;

        _isTesting = true;
        _error = null;
        _message = "Testing connection…";
        try
        {
            _ = await Providers.TestAsync(saved.Id, CancellationToken.None);
            await LoadProvidersAsync();
            _message = _selectedProvider?.LastTestSucceeded == true
                ? "Connection test completed."
                : "Connection test failed. Review the result below.";
        }
        catch (Exception)
        {
            _error = "Could not complete the connection test.";
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task RemoveProviderAsync()
    {
        if (_selectedProvider is null) return;
        var confirmed = await JavaScript.InvokeAsync<bool>("confirm", $"Remove provider ‘{_selectedProvider.Name}’?");
        if (!confirmed) return;
        await Providers.DeleteAsync(_selectedProvider.Id, CancellationToken.None);
        await LoadProvidersAsync();
        await LoadRoutingAsync();
        _message = "Provider removed.";
    }

    private static string ProviderStatusText(LlmProviderSummary provider) => provider.LastTestSucceeded switch
    {
        true => "Connected",
        false => $"Unreachable · {provider.LastTestedAtUtc?.ToLocalTime().ToString("g") ?? "last test"}",
        _ => "Not tested"
    };

    private static string YesNo(bool value) => value ? "Yes" : "No";
    private static string SupportText(bool? value) => value switch { true => "Supported", false => "Not supported", _ => "—" };
