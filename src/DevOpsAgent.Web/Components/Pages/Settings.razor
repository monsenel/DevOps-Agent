    // The list and the form change together (ProviderEditor): the form always shows the selected provider or is empty.
    private async Task LoadProvidersAsync(Guid? select = null)
    {
        _editor.Load(await Providers.ListAsync(CancellationToken.None), select);
        ProviderStatus.Set(_editor.Providers.FirstOrDefault(provider => provider.IsDefault));
        SyncSelection();
    }

    private void SyncSelection()
    {
        _hasSavedApiKey = _editor.Selected?.HasApiKey ?? false;
        _modelOptions.Clear();
        if (!string.IsNullOrWhiteSpace(_editor.Form.Model)) _modelOptions.Add(_editor.Form.Model);
    }

    private Task SelectProviderAsync(LlmProviderSummary provider)
    {
        _editor.Select(provider.Id);
        SyncSelection();
        _error = null;
        _message = null;
        return Task.CompletedTask;
    }

    private Task AddProviderAsync()
    {
        _editor.StartNew();
        SyncSelection();
        _error = null;
        _message = null;
        return Task.CompletedTask;
    }

    private async Task SelectSection(string section)
    {
        _section = section;
        _discoveryMessage = null;
        _discoveryError = null;
        if (section == "Discovery" && !_discoveryLoaded)
        {
            _discoveryIntervalHours = await DiscoverySchedule.GetIntervalHoursAsync(CancellationToken.None);
            _updateScanIntervalHours = await UpdateSchedule.GetIntervalHoursAsync(CancellationToken.None);
            _discoveryLoaded = true;
        }
        if (section == "Execution modes" && !_executionLoaded)
        {
            await LoadExecutionPoliciesAsync();
            _executionLoaded = true;
        }
        if (section == "Notifications" && !_notificationsLoaded)
        {
            var saved = await Notifications.GetAsync(CancellationToken.None);
            _telegramEnabled = saved.TelegramEnabled;
            _telegramChatId = saved.TelegramChatId;
            _hasTelegramToken = saved.HasTelegramBotToken;
            _ntfyEnabled = saved.NtfyEnabled;
            _ntfyBaseUrl = saved.NtfyBaseUrl;
            _hasNtfyTopic = saved.HasNtfyTopic;
            _hasNtfyToken = saved.HasNtfyToken;
            _minimumSeverity = saved.MinimumSeverity;
            var digest = await DailyDigest.GetSettingsAsync(CancellationToken.None);
            _digestEnabled = digest.Enabled;
            _digestUtcHour = digest.UtcHour;
            _digestLastSentAtUtc = digest.LastSentAtUtc;
            _notificationsLoaded = true;
        }
        _executionMessage = null;
        _executionError = null;
        _notificationMessage = null;
        _notificationError = null;
        _digestMessage = null;
        _digestError = null;
    }

    private async Task SaveNotificationsAsync()
    {
        _savingNotifications = true;
        _notificationMessage = null;
        _notificationError = null;
        try
        {
            await Notifications.SaveAsync(new NotificationSettingsInput(_telegramEnabled, _telegramToken, _telegramChatId,
                _ntfyEnabled, _ntfyBaseUrl, _ntfyTopic, _ntfyToken, _minimumSeverity), CancellationToken.None);
            _telegramToken = string.Empty;
            _ntfyToken = string.Empty;
            _ntfyTopic = string.Empty;
            var saved = await Notifications.GetAsync(CancellationToken.None);
            _hasTelegramToken = saved.HasTelegramBotToken;
            _hasNtfyToken = saved.HasNtfyToken;
            _hasNtfyTopic = saved.HasNtfyTopic;
            _notificationMessage = "Notification settings saved.";
        }
        catch (ArgumentException exception) { _notificationError = exception.Message; }
        finally { _savingNotifications = false; }
    }

    private async Task TestNotificationsAsync()
    {
        _testingNotifications = true;
        _notificationMessage = null;
        _notificationError = null;
        try
        {
            await Notifications.SaveAsync(new NotificationSettingsInput(_telegramEnabled, _telegramToken, _telegramChatId,
                _ntfyEnabled, _ntfyBaseUrl, _ntfyTopic, _ntfyToken, _minimumSeverity), CancellationToken.None);
