    protected override async Task OnInitializedAsync()
    {
        _toolLimit = await ToolLimits.GetAsync(CancellationToken.None);
        await LoadProvidersAsync();
        await LoadRoutingAsync();
    }

    private async Task LoadRoutingAsync()
    {
        var saved = await LlmRouting.GetAsync(CancellationToken.None);
        var existingIds = _editor.Providers.Select(provider => provider.Id).ToHashSet();
        _routeChatProviderId = saved.ChatProviderId is { } chatId && existingIds.Contains(chatId) ? chatId.ToString() : string.Empty;
        _routeQuickProviderId = saved.QuickSummaryProviderId is { } quickId && existingIds.Contains(quickId) ? quickId.ToString() : string.Empty;
        _routeSecurityProviderId = saved.SecurityAuditProviderId is { } secId && existingIds.Contains(secId) ? secId.ToString() : string.Empty;
        _fallbackEnabled = saved.FallbackEnabled;
        _fallbackProviderId = saved.FallbackProviderId is { } fbId && existingIds.Contains(fbId) ? fbId.ToString() : string.Empty;
    }

    private async Task SaveRoutingAsync()
    {
        _savingRouting = true;
        _routingMessage = null;
        _routingError = null;
        try
        {
            static Guid? ParseGuid(string value) => Guid.TryParse(value, out var parsed) ? parsed : null;
            var settings = new LlmRoutingSettings(
                ParseGuid(_routeChatProviderId),
                ParseGuid(_routeQuickProviderId),
                ParseGuid(_routeSecurityProviderId),
                _fallbackEnabled,
                ParseGuid(_fallbackProviderId));
            await LlmRouting.SaveAsync(settings, CancellationToken.None);
            _routingMessage = "Task routing and fallback settings saved.";
        }
        catch (ArgumentException exception)
        {
            _routingError = exception.Message.Split(" (Parameter")[0];
        }
        finally
        {
            _savingRouting = false;
        }
    }

    private void UpdateToolLimit(ChangeEventArgs args) => _toolLimit = int.TryParse(args.Value?.ToString(), out var limit) ? limit : 0;

