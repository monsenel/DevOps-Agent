@page "/settings"
@page "/settings/llm"
@inject ProviderService Providers
@inject LlmRoutingService LlmRouting
@inject ProviderStatusState ProviderStatus
@inject DiscoveryScheduleService DiscoverySchedule
@inject DevOpsAgent.Application.Updates.UpdateScheduleService UpdateSchedule
@inject ExecutionModeService ExecutionModes
@inject NotificationService Notifications
@inject DailyDigestService DailyDigest
@inject ToolCallLimitService ToolLimits
@inject IJSRuntime JavaScript

<PageTitle>Settings · DevOps Agent</PageTitle>

<div class="settings-content">
    <nav class="settings-tabs" aria-label="Settings sections">
        @foreach (var section in Sections)
        {
            <button type="button" class="@(section == _section ? "active" : null)"
                    aria-current="@(section == _section ? "page" : null)" @onclick="() => SelectSection(section)">
                @section
            </button>
        }
    </nav>

    @if (_section == "Execution modes")
    {
        <section class="ui-card execution-modes-card" aria-labelledby="execution-modes-title">
            <header class="ui-card-header"><h2 id="execution-modes-title">Execution modes</h2></header>
            <p class="muted">Choose how tool calls are handled for each server group. Shell commands always wait for approval.</p>
            @if (_executionUnreadable)
            {
                <div class="settings-message error" role="alert">The stored execution policies could not be read, so every group is treated as read-only. Saving a group rewrites the setting: that group gets your choice and all other groups stay read-only until you save them.</div>
            }
            @if (!string.IsNullOrWhiteSpace(_executionError))
            {
                <div class="settings-message error" role="alert">@_executionError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_executionMessage))
            {
                <div class="settings-message success" role="status">@_executionMessage</div>
            }
            @if (_executionPolicies.Count == 0)
            {
                <p class="empty-state-copy">Add a server to see its group execution settings.</p>
            }
            @foreach (var policy in _executionPolicies)
            {
                <section class="execution-group" aria-labelledby="execution-group-@policy.Group">
                    <div class="execution-group-heading">
                        <h3 id="execution-group-@policy.Group">@policy.Group</h3>
                        <div class="select-field">
                            <label for="execution-mode-@policy.Group">Mode</label>
                            <select id="execution-mode-@policy.Group" value="@policy.Mode"
                                    @onchange="args => UpdateExecutionModeForGroup(policy, args)">
                                <option value="ReadOnly">Read-only</option>
                                <option value="Confirm">Confirm each change</option>
                            </select>
                        </div>
                    </div>
                    <button class="ui-button primary" type="button" disabled="@_savingExecutionGroup"
                            @onclick="() => SaveExecutionPolicyAsync(policy)">
                        @(_savingExecutionGroup ? "Saving…" : "Save group policy")
                    </button>
                </section>
            }
        </section>
    }
    else if (_section == "Discovery")
    {
        <section class="ui-card discovery-settings-card" aria-labelledby="discovery-settings-title">
            <header class="ui-card-header"><h2 id="discovery-settings-title">Scheduled discovery</h2></header>
            <p class="muted">Discover all inventoried servers automatically and compare each snapshot for drift.</p>
            @if (!string.IsNullOrWhiteSpace(_discoveryMessage))
            {
                <div class="settings-message success" role="status">@_discoveryMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(_discoveryError))
            {
                <div class="settings-message error" role="alert">@_discoveryError</div>
            }
            <div class="field discovery-interval-field">
                <label for="discovery-interval">Run discovery every</label>
                <div class="discovery-interval-input">
                    <input id="discovery-interval" class="mono" type="number" min="@DiscoveryScheduleService.MinimumIntervalHours"
                           max="@DiscoveryScheduleService.MaximumIntervalHours" value="@_discoveryIntervalHours" @oninput="UpdateDiscoveryInterval" />
                    <span>hours</span>
                </div>
                <span class="field-helper">Choose between 1 and 24 hours. The default is 6 hours.</span>
            </div>
            <button class="ui-button primary" type="button" disabled="@_savingDiscovery" @onclick="SaveDiscoveryIntervalAsync">
                @(_savingDiscovery ? "Saving…" : "Save interval")
            </button>
        </section>

        <section class="ui-card discovery-settings-card" aria-labelledby="update-schedule-title">
            <h2 id="update-schedule-title">Scheduled update scans</h2>
            <p class="muted">Check inventoried servers automatically for OS updates and alert when security updates are pending. Read-only groups remain cache-only.</p>
            @if (!string.IsNullOrWhiteSpace(_updateScheduleMessage))
            {
                <div class="settings-message success" role="status">@_updateScheduleMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(_updateScheduleError))
            {
                <div class="settings-message error" role="alert">@_updateScheduleError</div>
            }
            <div class="field discovery-interval-field">
                <label for="update-scan-interval">Scan for updates every</label>
                <div class="discovery-interval-input">
                    <input id="update-scan-interval" class="mono" type="number" min="@DevOpsAgent.Application.Updates.UpdateScheduleService.MinimumIntervalHours"
                           max="@DevOpsAgent.Application.Updates.UpdateScheduleService.MaximumIntervalHours" value="@_updateScanIntervalHours" @oninput="UpdateScanIntervalChanged" />
                    <span>hours (0 = disabled)</span>
                </div>
                <span class="field-helper">Choose 0 to disable, or between 1 and 168 hours. Default is 24 hours.</span>
            </div>
            <button class="ui-button primary" type="button" disabled="@_savingUpdateSchedule" @onclick="SaveUpdateScanIntervalAsync">
                @(_savingUpdateSchedule ? "Saving…" : "Save update schedule")
            </button>
        </section>
    }
    else if (_section == "Notifications")
    {
        <section class="ui-card notification-settings-card" aria-labelledby="notification-settings-title">
            <header class="ui-card-header"><h2 id="notification-settings-title">Alert notifications</h2></header>
            <p class="muted">Send a message when an alert opens or resolves. Provider tokens are encrypted at rest.</p>
            @if (!string.IsNullOrWhiteSpace(_notificationError))
            {
                <div class="settings-message error" role="alert">@_notificationError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_notificationMessage))
            {
                <div class="settings-message success" role="status">@_notificationMessage</div>
            }
            <fieldset class="notification-provider">
                <legend>Telegram</legend>
                <SwitchRow Title="Enable Telegram" Helper="Send alert changes to a Telegram chat" @bind-Value="_telegramEnabled" />
                <div class="connection-form-grid">
                    <div class="field">
                        <label for="telegram-token">Bot token</label>
                        <input id="telegram-token" type="password" autocomplete="new-password" @bind="_telegramToken" @bind:event="oninput"
                               placeholder="@(_hasTelegramToken ? "Saved; blank keeps current token" : "Bot token")" />
                        <span class="field-helper">@(_hasTelegramToken ? "A token is saved. Leave blank to keep it." : "Stored encrypted and never shown again.")</span>
                    </div>
                    <Field Id="telegram-chat-id" Label="Chat ID" @bind-Value="_telegramChatId" Mono="true" />
                </div>
            </fieldset>
            <fieldset class="notification-provider">
                <legend>ntfy</legend>
                <SwitchRow Title="Enable ntfy" Helper="Publish to a topic on ntfy or your self-hosted server" @bind-Value="_ntfyEnabled" />
                <div class="connection-form-grid">
                    <Field Id="ntfy-url" Label="Server URL" @bind-Value="_ntfyBaseUrl" Mono="true" />
                    <div class="field">
                        <label for="ntfy-topic">Topic</label>
                        <input id="ntfy-topic" type="password" autocomplete="new-password" @bind="_ntfyTopic" @bind:event="oninput"
                               placeholder="@(_hasNtfyTopic ? "Saved; blank keeps current topic" : "Topic")" />
                        <span class="field-helper">@(_hasNtfyTopic ? "A topic is saved. Leave blank to keep it." : "Anyone who knows the topic can read it; stored encrypted and never shown again.")</span>
                    </div>
                    <div class="field">
                        <label for="ntfy-token">Access token (optional)</label>
                        <input id="ntfy-token" type="password" autocomplete="new-password" @bind="_ntfyToken" @bind:event="oninput"
                               placeholder="@(_hasNtfyToken ? "Saved; blank keeps current token" : "Bearer token")" />
                        <span class="field-helper">@(_hasNtfyToken ? "A token is saved. Leave blank to keep it." : "Stored encrypted and never shown again.")</span>
                    </div>
                </div>
            </fieldset>
            <div class="select-field notification-severity">
                <label for="notification-severity">Minimum severity</label>
                <select id="notification-severity" @bind="_minimumSeverity">
                    <option value="Low">Low and above</option>
                    <option value="Medium">Medium and above</option>
                    <option value="High">High and above</option>
                    <option value="Critical">Critical only</option>
                </select>
            </div>
            <div class="connection-actions">
                <Button Disabled="_savingNotifications || _testingNotifications" OnClick="SaveNotificationsAsync">@(_savingNotifications ? "Saving…" : "Save notifications")</Button>
                <Button Variant="secondary" Disabled="_savingNotifications || _testingNotifications" OnClick="TestNotificationsAsync">@(_testingNotifications ? "Sending…" : "Send test message")</Button>
            </div>
        </section>

        <section class="ui-card notification-settings-card" aria-labelledby="daily-digest-title">
            <header class="ui-card-header"><h2 id="daily-digest-title">Daily digest</h2></header>
            <p class="muted">Send a concise daily status summary (server counts, open alerts by severity, pending security updates, and 24h SSH security event count) via your enabled Telegram/ntfy channels. No secrets or host details leave the app.</p>
            @if (!string.IsNullOrWhiteSpace(_digestError))
            {
                <div class="settings-message error" role="alert">@_digestError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_digestMessage))
            {
                <div class="settings-message success" role="status">@_digestMessage</div>
            }
            <SwitchRow Title="Enable daily digest" Helper="Deliver once per UTC day at the configured hour" @bind-Value="_digestEnabled" />
            <div class="field discovery-interval-field">
                <label for="daily-digest-hour">Delivery hour (UTC)</label>
                <div class="discovery-interval-input">
                    <input id="daily-digest-hour" class="mono" type="number" min="@DailyDigestService.MinimumUtcHour"
                           max="@DailyDigestService.MaximumUtcHour" value="@_digestUtcHour" @oninput="UpdateDigestHour" />
                    <span>:00 UTC</span>
                </div>
                <span class="field-helper">
                    Choose an hour from 0 to 23 UTC.
                    @if (_digestLastSentAtUtc is { } lastSent)
                    {
                        <span> Last sent @lastSent.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC.</span>
                    }
                </span>
            </div>
            <div class="connection-actions">
                <Button Disabled="_savingDigest || _sendingDigest" OnClick="SaveDailyDigestAsync">@(_savingDigest ? "Saving…" : "Save daily digest")</Button>
                <Button Variant="secondary" Disabled="_savingDigest || _sendingDigest" OnClick="SendDailyDigestNowAsync">@(_sendingDigest ? "Sending…" : "Send digest now")</Button>
            </div>
        </section>
    }
    else if (_section != "LLM connection")
    {
        <PagePlaceholder Title="@_section" Description="This settings section will be available in a later task." />
    }
    else
    {
        <div class="settings-row llm-main-row">
            <section class="ui-card providers-card" aria-labelledby="providers-heading">
                <header class="ui-card-header"><h2 id="providers-heading">Providers</h2></header>
                @if (_editor.Providers.Count == 0)
                {
                    @* T8.1: no providers means an empty list and an empty "Add provider" form, never a form that looks saved. *@
                    <div class="provider-empty">
                        <strong>No providers yet</strong>
                        <p>Add Ollama, LM Studio, OpenRouter or any OpenAI-compatible endpoint to enable chat.</p>
                    </div>
                }
                <div class="provider-list">
                    @foreach (var provider in _editor.Providers)
                    {
                        <button type="button" class="provider-item @(_editor.SelectedId == provider.Id ? "selected" : null)"
                                aria-pressed="@(_editor.SelectedId == provider.Id)" @onclick="() => SelectProviderAsync(provider)">
                            <span class="provider-item-heading"><strong>@provider.Name</strong>
                                @if (provider.IsDefault) { <span class="ui-badge soft">Default</span> }
                            </span>
                            <span class="provider-url mono">@provider.BaseUrl</span>
                            <span class="provider-status @(provider.LastTestSucceeded == false ? "failed" : null)">@ProviderStatusText(provider)</span>
                        </button>
                    }
                </div>
                <div class="provider-list-spacer"></div>
                <Button Variant="@(_editor.IsNew ? "primary" : "secondary")" FullWidth="true" OnClick="AddProviderAsync">Add provider</Button>
            </section>

            <section class="ui-card connection-card" aria-labelledby="connection-heading">
                <header class="ui-card-header">
                    <h2 id="connection-heading">@(_editor.IsNew ? "Add provider" : "Connection")</h2>
                    @if (!_editor.IsNew && _editor.Selected is { } shown)
                    {
                        <span class="ui-badge soft">@shown.Name</span>
                    }
                </header>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="settings-message error" role="alert">@_error</div>
                }
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="settings-message success" role="status">@_message</div>
                }

                <div class="connection-form-grid">
                    <div class="select-field">
                        <label for="provider-type">Provider type</label>
                        <select id="provider-type" autocomplete="off" @bind="_editor.Form.Type" @bind:after="OnTypeChanged">
                            @if (_editor.Form.Type is null)
                            {
                                <option value="">Select a provider type</option>
                            }
                            <option value="Ollama">Ollama</option>
                            <option value="LmStudio">LM Studio</option>
                            <option value="OpenRouter">OpenRouter</option>
                            <option value="OpenAiCompatible">OpenAI-compatible (custom)</option>
                        </select>
                    </div>
                    <Field Id="provider-name" Label="Display name" @bind-Value="_editor.Form.Name" Autocomplete="off" />
                    <Field Id="provider-url" Label="Base URL" @bind-Value="_editor.Form.BaseUrl" Mono="true" Autocomplete="off"
                           Helper="Any endpoint that speaks the OpenAI chat completions API." />
                    <div class="field api-key-field">
                        <label for="provider-key">API key</label>
                        <input id="provider-key" class="mono" type="password" @bind="_editor.Form.ApiKey"
                               @bind:event="oninput" autocomplete="new-password" placeholder="@ApiKeyPlaceholder" />
                        <span class="field-helper">@ApiKeyHelper</span>
                    </div>
                    <div class="select-field model-select-field">
                        <label for="provider-model">Model</label>
                        <div class="model-refresh-row">
                            <select id="provider-model" class="mono" @bind="_editor.Form.Model">
                                @if (!_modelOptions.Contains(_editor.Form.Model, StringComparer.Ordinal))
                                {
                                    <option value="@_editor.Form.Model">@(_editor.Form.Model.Length == 0 ? "Select model" : _editor.Form.Model)</option>
                                }
                                @foreach (var model in _modelOptions)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                            <Button Variant="secondary" Disabled="_isRefreshing" OnClick="RefreshModelsAsync">@(_isRefreshing ? "Refreshing…" : "Refresh")</Button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="context-window">Context window (tokens)</label>
                        <input id="context-window" class="mono" type="number" min="0" step="1" @bind="_editor.Form.ContextWindow" />
                    </div>
                    <div class="field">
                        <label for="temperature">Temperature</label>
                        <input id="temperature" class="mono" type="number" min="0" max="2" step="0.1" @bind="_editor.Form.Temperature" />
                    </div>
                    <div class="field">
                        <label for="request-timeout">Request timeout (seconds)</label>
                        <input id="request-timeout" class="mono" type="number" min="1" max="600" step="1" @bind="_editor.Form.TimeoutSeconds" />
                    </div>
                </div>

                <div class="connection-switches">
                    <SwitchRow Title="Native tool calling" Helper="Off falls back to JSON in the prompt" @bind-Value="_editor.Form.NativeToolCallingEnabled" />
                    <SwitchRow Title="Streaming" Helper="Show answers as they are generated" @bind-Value="_editor.Form.StreamingEnabled" />
                    <SwitchRow Title="Use as default" Helper="For chat and tool calls" @bind-Value="_editor.Form.IsDefault" />
                </div>

                <div class="connection-actions">
                    <Button Disabled="_isSaving || _isTesting" OnClick="SaveAsync">@(_isSaving ? "Saving…" : "Save")</Button>
                    <Button Variant="secondary" Disabled="_isSaving || _isTesting" OnClick="TestConnectionAsync">@(_isTesting ? "Testing…" : "Test connection")</Button>
                    <span class="actions-spacer"></span>
                    @if (!_editor.IsNew)
                    {
                        <Button Variant="ghost-destructive" Disabled="_isSaving || _isTesting" OnClick="RemoveProviderAsync">Remove provider</Button>
                    }
                </div>
            </section>
        </div>

        <div class="settings-row llm-detail-row">
            <section class="ui-card test-result-card @TestResultClass" aria-labelledby="test-result-heading">
                <header class="ui-card-header"><h2 id="test-result-heading">@TestResultTitle</h2></header>
                @if (_selectedProvider?.LastTestSucceeded is null)
                {
                    <p class="muted">Run a connection test to check endpoint reachability, models, streaming, and tool calling.</p>
                }
                else
                {
                    <dl class="test-result-grid">
                        <dt>Endpoint reachable</dt><dd>@YesNo(_selectedProvider.LastTestSucceeded.Value)</dd>
                        <dt>Models listed</dt><dd>@(_selectedProvider.LastTestModelCount?.ToString() ?? "—")</dd>
                        <dt>Tool calling</dt><dd>@SupportText(_selectedProvider.LastTestToolCallingSupported)</dd>
                        <dt>Streaming</dt><dd>@SupportText(_selectedProvider.LastTestStreamingSupported)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_selectedProvider.LastTestError))
                    {
                        <p class="test-result-error">@_selectedProvider.LastTestError</p>
                    }
                    @if (_selectedProvider.LastTestedAtUtc is not null)
                    {
                        <p class="test-result-time">Last tested @(_selectedProvider.LastTestedAtUtc.Value.ToLocalTime().ToString("g"))</p>
                    }
                }
            </section>

            <section class="ui-card task-routing-card" aria-labelledby="task-routing-heading">
                <header class="ui-card-header"><h2 id="task-routing-heading">Task routing</h2></header>
                <p class="muted">Choose optional providers for chat, quick summaries, and security audits. Leave unset to use the default provider.</p>
                @if (!string.IsNullOrWhiteSpace(_routingMessage))
                {
                    <div class="settings-message success" role="status">@_routingMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_routingError))
                {
                    <div class="settings-message error" role="alert">@_routingError</div>
                }
                <div class="select-field">
                    <label for="route-chat">Chat and tool calls</label>
                    <select id="route-chat" @bind="_routeChatProviderId" disabled="@(_editor.Providers.Count == 0 || _savingRouting)">
                        <option value="">Use default provider</option>
                        @foreach (var provider in _editor.Providers)
                        {
                            <option value="@provider.Id">@provider.Name (@provider.Model)</option>
                        }
                    </select>
                </div>
                <div class="select-field">
                    <label for="route-quick">Quick / Summary</label>
                    <select id="route-quick" @bind="_routeQuickProviderId" disabled="@(_editor.Providers.Count == 0 || _savingRouting)">
                        <option value="">Use default provider</option>
                        @foreach (var provider in _editor.Providers)
                        {
                            <option value="@provider.Id">@provider.Name (@provider.Model)</option>
                        }
                    </select>
                </div>
                <div class="select-field">
                    <label for="route-security">Security / Audit</label>
                    <select id="route-security" @bind="_routeSecurityProviderId" disabled="@(_editor.Providers.Count == 0 || _savingRouting)">
                        <option value="">Use default provider</option>
                        @foreach (var provider in _editor.Providers)
                        {
                            <option value="@provider.Id">@provider.Name (@provider.Model)</option>
                        }
                    </select>
                </div>
                <button class="ui-button primary" type="button" disabled="@(_savingRouting || _editor.Providers.Count == 0)" @onclick="SaveRoutingAsync">
                    @(_savingRouting ? "Saving…" : "Save routing")
                </button>
            </section>

            <section class="ui-card cloud-options-card" aria-labelledby="cloud-options-heading">
                <header class="ui-card-header"><h2 id="cloud-options-heading">Cloud providers &amp; fallback</h2></header>
                <SwitchRow Title="Redact secrets before sending" Helper="Not applied to local or private-network endpoints (saved with provider)" @bind-Value="_editor.Form.RedactSecretsBeforeSending" />
                <SwitchRow Title="Fallback on failure" Helper="Try another provider automatically when the primary endpoint fails or is unreachable" @bind-Value="_fallbackEnabled" />
                <div class="select-field">
                    <label for="fallback-provider">Fallback provider</label>
                    <select id="fallback-provider" @bind="_fallbackProviderId" disabled="@(!_fallbackEnabled || _editor.Providers.Count == 0 || _savingRouting)">
                        <option value="">Auto (next available provider)</option>
                        @foreach (var provider in _editor.Providers)
                        {
                            <option value="@provider.Id">@provider.Name (@provider.Model)</option>
                        }
                    </select>
                </div>
                <button class="ui-button secondary" type="button" disabled="@(_savingRouting || _editor.Providers.Count == 0)" @onclick="SaveRoutingAsync">
                    @(_savingRouting ? "Saving…" : "Save fallback")
                </button>
            </section>

            <section class="ui-card tool-limit-card" aria-labelledby="tool-limit-heading">
                <header class="ui-card-header"><h2 id="tool-limit-heading">Agent tool calls</h2></header>
                <p class="muted">How many tool calls the agent may make for one message. A lower chat effort can reduce it (Low 8, Medium 15, High 30), but never above this setting.</p>
                @if (!string.IsNullOrWhiteSpace(_toolLimitMessage))
                {
                    <div class="settings-message success" role="status">@_toolLimitMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_toolLimitError))
                {
                    <div class="settings-message error" role="alert">@_toolLimitError</div>
                }
                <div class="field">
                    <label for="tool-call-limit">Tool calls per message</label>
                    <input id="tool-call-limit" class="mono" type="number" min="@ToolCallLimitService.MinimumLimit" max="@ToolCallLimitService.MaximumLimit"
                           value="@_toolLimit" @oninput="UpdateToolLimit" />
                    <span class="field-helper">Between @ToolCallLimitService.MinimumLimit and @ToolCallLimitService.MaximumLimit. The default is @ToolCallLimitService.DefaultLimit.</span>
                </div>
                <button class="ui-button primary" type="button" disabled="@_savingToolLimit" @onclick="SaveToolLimitAsync">
                    @(_savingToolLimit ? "Saving…" : "Save limit")
                </button>
            </section>
        </div>
    }
</div>

@code {
    private static readonly string[] Sections = ["LLM connection", "Servers and SSH", "Execution modes", "Notifications", "Discovery"];
    private readonly ProviderEditor _editor = new();
    private readonly List<string> _modelOptions = [];
    private string _section = "LLM connection";
    private string? _error;
    private string? _message;
    private bool _hasSavedApiKey;
    private bool _isRefreshing;
    private bool _isSaving;
    private bool _isTesting;
    private int _discoveryIntervalHours = DiscoveryScheduleService.DefaultIntervalHours;
    private bool _discoveryLoaded;
    private bool _savingDiscovery;
    private string? _discoveryMessage;
    private string? _discoveryError;
    private int _updateScanIntervalHours = DevOpsAgent.Application.Updates.UpdateScheduleService.DefaultIntervalHours;
    private bool _savingUpdateSchedule;
    private string? _updateScheduleMessage;
    private string? _updateScheduleError;
    private readonly List<ExecutionModePolicy> _executionPolicies = [];
    private bool _executionLoaded;
    private bool _executionUnreadable;
    private bool _savingExecutionGroup;
    private string? _executionMessage;
    private string? _executionError;
    private bool _notificationsLoaded;
    private bool _telegramEnabled;
    private string _telegramToken = string.Empty;
    private string _telegramChatId = string.Empty;
    private bool _hasTelegramToken;
    private bool _ntfyEnabled;
    private string _ntfyBaseUrl = "https://ntfy.sh";
    private string _ntfyTopic = string.Empty;
    private string _ntfyToken = string.Empty;
    private bool _hasNtfyToken;
    private bool _hasNtfyTopic;
    private AlertSeverity _minimumSeverity = AlertSeverity.Medium;
    private bool _savingNotifications;
    private bool _testingNotifications;
    private string? _notificationMessage;
    private string? _notificationError;
    private bool _digestEnabled;
    private int _digestUtcHour = DailyDigestService.DefaultUtcHour;
    private DateTimeOffset? _digestLastSentAtUtc;
    private bool _savingDigest;
    private bool _sendingDigest;
    private string? _digestMessage;
    private string? _digestError;
    private LlmProviderSummary? _selectedProvider => _editor.Selected;
    private int _toolLimit = ToolCallLimitService.DefaultLimit;
    private bool _savingToolLimit;
    private string? _toolLimitMessage;
    private string? _toolLimitError;
    private string _routeChatProviderId = string.Empty;
    private string _routeQuickProviderId = string.Empty;
    private string _routeSecurityProviderId = string.Empty;
    private bool _fallbackEnabled;
    private string _fallbackProviderId = string.Empty;
    private bool _savingRouting;
    private string? _routingMessage;
    private string? _routingError;

    private string ApiKeyPlaceholder => _editor.Form.Type switch
    {
        ProviderType.Ollama => "Not required for Ollama",
        ProviderType.OpenRouter => "OpenRouter API key",
        null => "Choose a provider type first",
        _ => "Optional API key"
    };

    private string ApiKeyHelper => _hasSavedApiKey
        ? "A key is saved. Leave blank to keep it, or enter a replacement."
