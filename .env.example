# Set these to the numeric UID/GID of the host user who owns ./data.
DVA_UID=1000
DVA_GID=1000
ASPNETCORE_URLS=http://+:8080

# Used by the single-user login added in T0.4.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# For local setup only, alternatively set ADMIN_PASSWORD and let the app hash it at startup.

# Optional names allowed to run sudo without a security alert.
# The app's own sudo commands (a fixed list, see README › Sudo on managed servers) never alert; any other sudo by its SSH
# user does. Adding that user here silences those alerts too, so only do it if you accept losing that signal.
# Add indexed entries as needed, for example: SecurityMonitoring__SudoAllowlist__0=deploy
